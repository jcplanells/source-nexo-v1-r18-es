{{!< default}}
{{#post}}

<main class="gh-main">

    <article class="gh-article {{post_class}}">

        <header class="gh-article-header gh-canvas">

            {{!-- Ocultar featured image si el post tiene el tag "graficas" --}}
            {{#has tag="graficas"}}
                {{!-- No mostrar imagen --}}
            {{else}}
                {{> "feature-image"}}
            {{/has}}

            {{#if primary_tag}}
                <a class="gh-article-tag" href="{{primary_tag.url}}">{{primary_tag.name}}</a>
            {{/if}}
            <h1 class="gh-article-title is-title">{{title}}</h1>

            {{#if custom_excerpt}}
                <p class="gh-article-excerpt is-body">{{custom_excerpt}}</p>
            {{/if}}

            {{#if @custom.show_post_metadata}}
            <div class="gh-article-meta">
                <div class="gh-article-meta-wrapper">
                    <div class="gh-article-meta-content">
                        <time class="gh-article-meta-date" datetime="{{date format='YYYY-MM-DD HH:mm'}}">{{date format='D'}} de {{date format='MMMM'}} de {{date format='YYYY, HH:mm'}}</time>
                        {{#if reading_time}}
                            <span class="gh-article-meta-length"><span class="bull">—</span> {{reading_time minute="1 min de lectura" minutes="% min de lectura"}}</span>
                        {{/if}}
                    </div>
                </div>
            </div>
            {{/if}}

        </header>

        <section class="gh-content gh-canvas is-body{{#if @custom.enable_drop_caps_on_posts}} drop-cap{{/if}}">
            {{content}}
        </section>

        <div id="cta-inferior">
            {{> "components/cta-registro"}}
        </div>

    </article>

    {{#if comments}}
        <div class="gh-comments gh-canvas">
            {{comments}}
        </div>
    {{/if}}

</main>

{{/post}}

{{#if @custom.show_related_articles}}
    {{#get "posts" include="authors" filter="id:-{{post.id}}" limit="4" as |next|}}
        {{#if next}}
            <section class="gh-container is-grid gh-outer">
                <div class="gh-container-inner gh-inner">
                    <h2 class="gh-container-title"><span style="border-bottom: 3px solid var(--ghost-accent-color); padding-bottom: 9px;">Artículos relacionados</span></h2>
                    <div class="gh-feed">
                        {{#foreach next}}
                            {{> "post-card" lazyLoad=true}}
                        {{/foreach}}
                    </div>
                </div>
            </section>
        {{/if}}
    {{/get}}
{{/if}}
