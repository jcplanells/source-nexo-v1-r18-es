{{!< default}}
{{#post}}
{{> "components/topbar-preview" variant="green"}}
<script>window._nexoIsMember = {{#if @member}}true{{else}}false{{/if}};</script>
<style>
    .post-with-sidebar-wrap {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 340px;
        max-width: 1280px;
        margin: 0 auto;
    }
    .post-sidebar {
        padding-top: 48px;
        padding-right: max(4vmin, 20px);
    }
    .post-sidebar-sticky {
        position: sticky;
        top: 24px;
    }
    .post-sidebar-inner {
        padding-top: 24px;
        border-top: 1px solid var(--color-border, #e0e0e0);
    }
    .post-sidebar-inner .gh-container-title {
        margin-bottom: 16px;
        font-size: 1.8rem;
        color: var(--color-base, #000);
    }
    .post-sidebar-inner .gh-featured-feed {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }
    @media (max-width: 1099px) {
        .post-with-sidebar-wrap {
            display: block;
        }
        .post-sidebar {
            display: none;
        }
    }
</style>

<main class="gh-main">

    <div class="post-with-sidebar-wrap">
    <div class="post-article-col">
    <article class="gh-article {{post_class}}">

        <header class="gh-article-header gh-canvas">

            {{> "feature-image"}}

            {{#if primary_tag}}
                <a class="gh-article-tag" href="{{primary_tag.url}}">{{primary_tag.name}}</a>
            {{/if}}
            <h1 class="gh-article-title is-title">{{title}}</h1>

            {{#if custom_excerpt}}
                <p class="gh-article-excerpt is-body">{{custom_excerpt}}</p>
            {{/if}}

            <div class="gh-article-meta">
                <div class="gh-article-meta-wrapper">
                    <div class="gh-article-meta-content">
                        {{!-- Byline: se oculta para la cuenta genérica "Redacción nexo.la" (slug: nexo)
                             y se muestra para cualquier otro autor, enlazado a su página de perfil. --}}
                        {{#match primary_author.slug "!=" "nexo"}}
                            <address class="gh-article-meta-author">Por {{#foreach authors}}<a href="{{url}}" rel="author">{{name}}</a>{{#unless @last}}, {{/unless}}{{/foreach}}</address>
                            <span class="bull">—</span>
                        {{/match}}
                        <time class="gh-article-meta-date" datetime="{{date format='YYYY-MM-DD HH:mm'}}">{{date format='D'}} de {{date format='MMMM'}} de {{date format='YYYY, HH:mm'}}</time>
                        {{#if reading_time}}
                            <span class="gh-article-meta-length"><span class="bull">—</span> {{reading_time minute="1 min de lectura" minutes="% min de lectura"}}</span>
                        {{/if}}
                    </div>
                </div>
            </div>

            <div class="gh-share-row">
                <a href="#/share" class="gh-share-btn">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
                    Compartir
                </a>
                <a href="https://wa.me/?text={{url absolute='true'}}?utm_source=whatsapp&utm_medium=social&utm_campaign=share" class="gh-share-btn gh-share-btn--whatsapp" target="_blank" rel="noopener">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>
                    WhatsApp
                </a>
            </div>

        </header>

        <section class="gh-content gh-canvas is-body">
            {{content}}
        </section>

        {{!-- Variante A: CTA inline tras el 3er párrafo, y Banner Ad Manager tras el 5to.
             Los párrafos se capturan una sola vez, antes de insertar nada: el CTA trae
             sus propios <p> internos, y si se recalculara después de insertarlo esos
             párrafos se colarían en el conteo y el banner podría terminar dentro del CTA. --}}
        {{> "components/cta-inline"}}
        {{> "components/banner-post-interior"}}
        <script>
        (function () {
            var paragraphs = document.querySelectorAll('.gh-content p');
            var ctaTarget = paragraphs[2] || paragraphs[paragraphs.length - 1];
            var bannerTarget = paragraphs[4] || paragraphs[paragraphs.length - 1];

            var cta = document.getElementById('cta-inline-wrap');
            var ctaInserted = false;
            if (cta && !window._nexoIsMember && ctaTarget) {
                cta.style.display = '';
                ctaTarget.parentNode.insertBefore(cta, ctaTarget.nextSibling);
                ctaInserted = true;
            }

            var banner = document.getElementById('banner-post-interior-wrap');
            if (banner && bannerTarget) {
                var anchor = bannerTarget;
                if (ctaInserted && bannerTarget === ctaTarget) {
                    anchor = cta;
                }
                banner.style.display = '';
                anchor.parentNode.insertBefore(banner, anchor.nextSibling);
            }
        }());
        </script>

        <div class="gh-canvas" id="nexo-poll-wrap" style="margin-top: 32px;">
            <div data-nexo-poll="c3068039-d432-4a02-a5b5-dbbbe787f9ed"></div>
            <script async src="https://polls.nexo.la/embed.js"></script>
        </div>
        <script>
        (function () {
            var KEY = 'nexo_poll_voted';
            var wrap = document.getElementById('nexo-poll-wrap');
            if (!wrap) return;

            // Ocultar si ya votó
            if (localStorage.getItem(KEY)) {
                wrap.style.display = 'none';
                return;
            }

            // Observar cambios dentro del bloque de la encuesta.
            // Cuando el usuario vota, el embed reemplaza el formulario con los resultados,
            // lo que genera mutaciones en el DOM. Esperamos al menos 2 para evitar
            // el disparo durante la carga inicial.
            var mutations = 0;
            var observer = new MutationObserver(function () {
                mutations++;
                if (mutations >= 2) {
                    observer.disconnect();
                    localStorage.setItem(KEY, '1');
                }
            });
            observer.observe(wrap, { childList: true, subtree: true, attributes: true });
        }());
        </script>

        {{!-- Anuncio fijo 300x250 solo en móvil (unidad "Articulo Movil", separada del responsivo del sidebar) --}}
        <div class="gh-canvas" id="post-mobile-ad-wrap"></div>
        <script>
        (function () {
            if (window.innerWidth >= 1100) return;
            var wrap = document.getElementById('post-mobile-ad-wrap');
            if (!wrap) return;
            wrap.innerHTML = '<div style="margin:24px auto;max-width:300px;text-align:center;">' +
                '<ins class="adsbygoogle" style="display:inline-block;width:300px;height:250px" ' +
                'data-ad-client="ca-pub-9061854370540184" data-ad-slot="4515734152"></ins></div>';
            (window.adsbygoogle = window.adsbygoogle || []).push({});
        }());
        </script>

    </article>
    </div>{{!-- /.post-article-col --}}

    <aside class="post-sidebar">
        <div class="post-sidebar-sticky">
            <div style="margin-bottom: 24px; display: flex; justify-content: center;">
                <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9061854370540184" crossorigin="anonymous"></script>
                <div id="div-gpt-ad-sidebar-post-0" style="min-width: 160px; min-height: 200px;"></div>
                <script>
                (function () {
                    if (window.innerWidth < 1100) return;
                    googletag.cmd.push(function() { googletag.display('div-gpt-ad-sidebar-post-0'); });
                }());
                </script>
            </div>
            <div class="post-sidebar-inner">
                <h2 class="gh-container-title">
                    <span style="border-bottom: 3px solid var(--ghost-accent-color); padding-bottom: 9px;">Más leídas</span>
                </h2>
                <div class="gh-featured-feed" id="post-leidas-feed">
                    <p style="color:#888; font-size:1.4rem">Cargando...</p>
                </div>
            </div>
        </div>
    </aside>
    </div>{{!-- /.post-with-sidebar-wrap --}}

    <script>
    (function () {
        var GHOST_URL = 'https://nexo-la.ghost.io';
        var GHOST_KEY = '4814aa41c8315fc5648524c04c';
        var feed = document.getElementById('post-leidas-feed');
        if (!feed) return;

        fetch('https://opt.nexo.la/assets/json/mas_leidas.json')
            .then(function (r) { return r.json(); })
            .then(function (data) {
                var items = data[0] && data[0].top;
                if (!items || !items.length) throw new Error();
                var filtered = items.filter(function (item) {
                    return item.url.indexOf('/tag/') === -1;
                });
                var slugs = filtered.slice(0, 6).map(function (item) {
                    return item.url.split('?')[0].replace(/\/$/, '').split('/').pop();
                });
                return fetch(GHOST_URL + '/ghost/api/content/posts/?key=' + GHOST_KEY +
                    '&filter=' + encodeURIComponent('slug:[' + slugs.join(',') + ']') +
                    '&include=tags&fields=title,slug,url,feature_image,primary_tag,published_at&limit=6')
                    .then(function (r) { return r.json(); })
                    .then(function (ghost) {
                        var posts = ghost.posts;
                        if (!posts || !posts.length) throw new Error();
                        var map = {};
                        posts.forEach(function (p) { map[p.slug] = p; });
                        var html = '';
                        var num = 0;
                        slugs.forEach(function (slug) {
                            var p = map[slug];
                            if (!p) return;
                            num++;
                            var jsonItem = filtered.find(function (i) { return i.url.indexOf(slug) !== -1; });
                            var base = jsonItem ? jsonItem.url : p.url;
                            var url = base + (base.indexOf('?') !== -1 ? '&' : '?') + 'utm_source=nexo&utm_medium=articulo&utm_campaign=las_mas_leidas';
                            html += '<article class="gh-card">' +
                                '<a class="gh-card-link" href="' + url + '">' +
                                (p.feature_image ? '<figure class="gh-card-image"><img src="' + p.feature_image + '" sizes="80px" alt="' + p.title.replace(/"/g, '&quot;') + '" loading="lazy"></figure>' : '') +
                                '<div class="gh-card-wrapper">' +
                                (p.primary_tag ? '<p class="gh-card-tag">' + p.primary_tag.name + '</p>' : '') +
                                '<h3 class="gh-card-title is-title"><span class="gh-leidas-num">' + num + '</span> ' + p.title + '</h3>' +
                                '</div></a></article>';
                        });
                        feed.innerHTML = html || '';
                    });
            })
            .catch(function () { feed.innerHTML = ''; });
    }());
    </script>

    {{!-- Variante C: CTA por categoría --}}
    <div class="gh-outer" style="padding: 0 max(4vmin, 20px)">
        {{> "components/cta-categoria"}}
    </div>

    <script>window._nexoMasLeidas = Math.random() < 0.5;</script>

    <section class="gh-container gh-outer" id="mas-leidas-wrap" style="display:none">
        <div class="gh-container-inner gh-inner">
            <h2 class="gh-container-title"><span style="border-bottom: 3px solid var(--ghost-accent-color); padding-bottom: 9px;">Las más leídas</span></h2>
            <ol class="mas-leidas-list"></ol>
        </div>
    </section>
    <script>
    (function () {
        if (!window._nexoMasLeidas) return;

        var GHOST_URL = 'https://nexo-la.ghost.io';
        var GHOST_KEY = '4814aa41c8315fc5648524c04c';

        fetch('https://opt.nexo.la/assets/json/mas_leidas.json')
            .then(function (r) { return r.json(); })
            .then(function (data) {
                var items = data[0] && data[0].top;
                if (!items || !items.length) return;

                var slugs = items.slice(0, 4).map(function (item) {
                    return item.url.split('?')[0].replace(/\/$/, '').split('/').pop();
                });

                var apiUrl = GHOST_URL + '/ghost/api/content/posts/' +
                    '?key=' + GHOST_KEY +
                    '&filter=' + encodeURIComponent('slug:[' + slugs.join(',') + ']') +
                    '&include=tags' +
                    '&fields=title,slug,url,feature_image,custom_excerpt,excerpt,primary_tag,reading_time,published_at' +
                    '&limit=4';

                return fetch(apiUrl)
                    .then(function (r) { return r.json(); })
                    .then(function (ghostData) {
                        var posts = ghostData.posts;
                        if (!posts || !posts.length) return;

                        var postMap = {};
                        posts.forEach(function (p) { postMap[p.slug] = p; });

                        var wrap = document.getElementById('mas-leidas-wrap');
                        wrap.classList.add('is-grid');
                        var feed = wrap.querySelector('.mas-leidas-list');
                        feed.className = 'gh-feed';

                        slugs.forEach(function (slug) {
                            var post = postMap[slug];
                            if (!post) return;

                            var jsonItem = items.find(function (i) { return i.url.indexOf(slug) !== -1; });
                            var baseUrl = jsonItem ? jsonItem.url : post.url;
                            var sep = baseUrl.indexOf('?') !== -1 ? '&' : '?';
                            var url = baseUrl + sep + 'utm_source=nexo&utm_medium=post&utm_campaign=las_mas_leidas';

                            var rt = post.reading_time || 1;
                            var rtText = rt === 1 ? '1 min de lectura' : rt + ' min de lectura';

                            var d = new Date(post.published_at);
                            var h = d.getHours(), m = d.getMinutes();
                            var ampm = h >= 12 ? 'p.m.' : 'a.m.';
                            h = h % 12 || 12;
                            var timeStr = h + ':' + (m < 10 ? '0' + m : m) + ' ' + ampm;

                            var imageHtml = post.feature_image
                                ? '<figure class="gh-card-image"><img src="' + post.feature_image + '" alt="' + post.title.replace(/"/g, '&quot;') + '" loading="lazy"></figure>'
                                : '';

                            var tagHtml = post.primary_tag
                                ? '<p class="gh-card-tag">' + post.primary_tag.name + '</p>'
                                : '';

                            var exc = post.custom_excerpt || post.excerpt || '';
                            var excerptHtml = exc
                                ? '<p class="gh-card-excerpt is-body">' + exc + '</p>'
                                : '';

                            var article = document.createElement('article');
                            article.className = 'gh-card';
                            article.innerHTML =
                                '<a class="gh-card-link" href="' + url + '">' +
                                    imageHtml +
                                    '<div class="gh-card-wrapper">' +
                                        tagHtml +
                                        '<h3 class="gh-card-title is-title"><span class="post-time">' + timeStr + '</span> — ' + post.title + '</h3>' +
                                        excerptHtml +
                                        '<footer class="gh-card-meta"><span class="gh-card-reading">' + rtText + '</span></footer>' +
                                    '</div>' +
                                '</a>';

                            feed.appendChild(article);
                        });

                        wrap.style.display = '';
                    });
            })
            .catch(function () {});
    }());
    </script>

    {{#if @custom.show_related_articles}}
        {{#get "posts" include="authors" filter="primary_tag:{{primary_tag.slug}}+id:-{{id}}" limit="4" as |next|}}
            {{#if next}}
                <section class="gh-container is-grid gh-outer" id="related-articles" style="display:none">
                    <div class="gh-container-inner gh-inner">
                        <h2 class="gh-container-title"><span style="border-bottom: 3px solid var(--ghost-accent-color); padding-bottom: 9px;">Más artículos de {{../primary_tag.name}}</span></h2>
                        <div class="gh-feed">
                            {{#foreach next}}
                                {{> "post-card" lazyLoad=true}}
                            {{/foreach}}
                        </div>
                    </div>
                </section>
                <script>
                (function () {
                    if (window._nexoMasLeidas) return;
                    var section = document.getElementById('related-articles');
                    section.style.display = '';
                    var utm = '?utm_source=nexo&utm_medium=post&utm_campaign=related';
                    section.querySelectorAll('.gh-card-link').forEach(function (a) {
                        a.href = a.href + utm;
                    });
                }());
                </script>
            {{/if}}
        {{/get}}
    {{/if}}

    <div id="deportes-short-wrap" class="gh-canvas deportes-short-wrap" style="display:none">
        <div class="deportes-short-label">Video corto</div>
        <div class="deportes-short-player"></div>
    </div>
    <script>
    (function () {
        fetch('https://opt.nexo.la/assets/json/video_creatomate.json')
            .then(function (r) { return r.json(); })
            .then(function (data) {
                var v = data && data.video;
                if (!v || v.platform !== 'youtube' || !v.id) return;
                var wrap = document.getElementById('deportes-short-wrap');
                var player = wrap.querySelector('.deportes-short-player');
                wrap.style.display = '';
                var observer = new IntersectionObserver(function (entries, obs) {
                    if (!entries[0].isIntersecting) return;
                    obs.disconnect();
                    var iframe = document.createElement('iframe');
                    iframe.src = 'https://www.youtube.com/embed/' + v.id + '?rel=0&autoplay=1&mute=1';
                    iframe.setAttribute('frameborder', '0');
                    iframe.setAttribute('allowfullscreen', '');
                    iframe.setAttribute('allow', 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share; fullscreen');
                    player.appendChild(iframe);
                }, { rootMargin: '200px' });
                observer.observe(wrap);
            })
            .catch(function () {});
    }());
    </script>

    <div id="cta-inferior">
        {{> "components/cta-registro"}}
    </div>

    {{!-- Variante D: popup scroll-triggered --}}
    {{> "components/cta-popup"}}

    {{#if comments}}
        <div class="gh-comments gh-canvas">
            {{comments}}
        </div>
    {{/if}}
</main>
{{/post}}
