{{!< default}}

{{#post}}
<main class="gh-main gh-outer">

    <section class="gh-archive gh-inner">
        <div class="gh-archive-inner">
            <header class="gh-archive-wrapper">
                <h1 class="gh-article-title is-title">Empleos y Emprendimiento</h1>
                {{#if custom_excerpt}}
                    <p class="gh-article-excerpt">{{custom_excerpt}}</p>
                {{/if}}
            </header>
        </div>
    </section>

    <section class="gh-container is-grid gh-outer">
        <div class="gh-container-inner gh-inner">
            <main class="gh-main">
                <div class="gh-feed">
                    {{#get "posts" filter="tag:[empleos,emprendimiento]" limit="20" include="authors,tags" order="published_at desc"}}
                        {{#foreach posts}}
                            {{> "post-card" lazyLoad=true showDate=true}}
                        {{/foreach}}
                    {{else}}
                        <p style="grid-column: 1 / -1; text-align: center; color: var(--color-secondary-text);">No hay artículos disponibles.</p>
                    {{/get}}
                </div>
            </main>
        </div>
    </section>

</main>
{{/post}}
