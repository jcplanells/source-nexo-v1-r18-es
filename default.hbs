<!DOCTYPE html>
<html lang="{{@site.locale}}">
<head>

    {{!-- Basic meta - advanced meta is output with {{ghost_head}} below --}}
    <title>{{meta_title}}</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    {{!-- Preload main styles and scripts for better performance --}}
    <link rel="preload" as="style" href="{{asset "built/screen.css"}}">
    <link rel="preload" as="script" href="{{asset "built/source.js"}}">
    
    {{!-- Fonts are preloaded and defined in the default template to avoid layout shift --}}
    {{> "typography/fonts"}}

    {{!-- CTA newsletter fonts --}}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=DM+Sans:wght@400;500&display=swap" rel="stylesheet">

    {{!-- Theme assets - use the {{asset}} helper to reference styles & scripts, this will take care of caching and cache-busting automatically --}}
    <link rel="stylesheet" type="text/css" href="{{asset "built/screen.css"}}">

    {{#is "home, post, tag, author"}}
    {{!-- Google Ad Manager (GPT) - cargado temprano para mejorar el tiempo de entrega del anuncio --}}
    <script async src="https://securepubads.g.doubleclick.net/tag/js/gpt.js" crossorigin="anonymous"></script>
    <script>
        window.googletag = window.googletag || {cmd: []};
    </script>
    {{/is}}

    {{#is "home"}}
    <script>
        googletag.cmd.push(function() {
            var mapping = googletag.sizeMapping()
                .addSize([768, 0], [728, 90])
                .addSize([0, 0], [[320, 100], [300, 250]])
                .build();
            googletag.defineSlot('/23361752465/banner_principal_home', [[320, 100], [728, 90], [300, 250]], 'div-gpt-ad-1783866034679-0')
                .defineSizeMapping(mapping)
                .addService(googletag.pubads());
            googletag.defineSlot('/23361752465/2', [[728, 90], [300, 250], [970, 90]], 'div-gpt-ad-1787348717387-0')
                .addService(googletag.pubads());
            var mappingNavHome = googletag.sizeMapping()
                .addSize([768, 0], [728, 90])
                .addSize([0, 0], [[320, 50], [320, 100]])
                .build();
            googletag.defineSlot('/23361752465/14', [[728, 90], [320, 50], [320, 100]], 'div-gpt-ad-1788220733424-0')
                .defineSizeMapping(mappingNavHome)
                .addService(googletag.pubads());
            googletag.defineSlot('/23361752465/15', [[300, 100], [300, 250], [728, 90]], 'div-gpt-ad-1788267491541-0')
                .addService(googletag.pubads());
            googletag.pubads().enableSingleRequest();
            googletag.enableServices();
        });
    </script>
    {{/is}}

    {{#is "tag, author"}}
    {{!-- Google Ad Manager (GPT) - banner tras la nota #3 en secciones/tags.
         Se repite cada 12 notas gracias al scroll infinito (pagination.js), así
         que cada aparición del bloque .gh-ad-archive se activa dinámicamente
         con su propio id/slot en vez de usar uno fijo. --}}
    <script>
        googletag.cmd.push(function() {
            googletag.pubads().enableSingleRequest();
            googletag.enableServices();
        });

        (function () {
            var adCounter = 0;

            function activateAd(el) {
                el.dataset.adActivated = 'true';

                var id = 'div-gpt-ad-archive-' + (++adCounter);
                el.id = id;

                var path = el.dataset.adPath;
                var sizes = el.dataset.adSizes.split(',').map(function (size) {
                    return size.split('x').map(Number);
                });

                googletag.cmd.push(function () {
                    googletag.defineSlot(path, sizes, id).addService(googletag.pubads());
                    googletag.display(id);
                });
            }

            function scan(root) {
                root.querySelectorAll('.gh-ad-archive:not([data-ad-activated])').forEach(activateAd);
            }

            document.addEventListener('DOMContentLoaded', function () {
                var feed = document.querySelector('.gh-feed');
                if (!feed) return;

                scan(feed);

                new MutationObserver(function () {
                    scan(feed);
                }).observe(feed, {childList: true});
            });
        })();
    </script>
    {{/is}}

    {{#is "post"}}
    {{!-- Google Ad Manager (GPT) - banner dentro del artículo, tras el 5to párrafo --}}
    <script>
        googletag.cmd.push(function() {
            googletag.defineSlot('/23361752465/banner_post_interior', [300, 250], 'div-gpt-ad-post-interior-0')
                .addService(googletag.pubads());
            googletag.defineSlot('/23361752465/1', [[200, 200], [160, 600]], 'div-gpt-ad-sidebar-post-0')
                .addService(googletag.pubads());
            var mappingNavPost = googletag.sizeMapping()
                .addSize([768, 0], [728, 90])
                .addSize([0, 0], [[320, 50], [320, 100]])
                .build();
            googletag.defineSlot('/23361752465/13', [[728, 90], [320, 50], [320, 100]], 'div-gpt-ad-1788281892417-0')
                .defineSizeMapping(mappingNavPost)
                .addService(googletag.pubads());
            googletag.pubads().enableSingleRequest();
            googletag.enableServices();
        });
    </script>
    {{/is}}

    {{!-- Custom background color --}}
    <style>
        :root {
            --background-color: {{@custom.site_background_color}}
        }
    </style>

    <script>
        /* The script for calculating the color contrast has been taken from
        https://gomakethings.com/dynamically-changing-the-text-color-based-on-background-color-contrast-with-vanilla-js/ */
        var accentColor = getComputedStyle(document.documentElement).getPropertyValue('--background-color');
        accentColor = accentColor.trim().slice(1);

        if (accentColor.length === 3) {
            accentColor = accentColor[0] + accentColor[0] + accentColor[1] + accentColor[1] + accentColor[2] + accentColor[2];
        }

        var r = parseInt(accentColor.substr(0, 2), 16);
        var g = parseInt(accentColor.substr(2, 2), 16);
        var b = parseInt(accentColor.substr(4, 2), 16);
        var yiq = ((r * 299) + (g * 587) + (b * 114)) / 1000;
        var textColor = (yiq >= 128) ? 'dark' : 'light';

        document.documentElement.className = `has-${textColor}-text`;
    </script>

    {{!-- This tag outputs all your advanced SEO meta, structured data, and other important settings, it should always be the last tag before the closing head tag --}}
    {{ghost_head}}

    <script>
    (function() {
        var ldScripts = document.querySelectorAll('script[type="application/ld+json"]');
        var hasLiveBlog = [].some.call(ldScripts, function(s) {
            try { return JSON.parse(s.textContent)['@type'] === 'LiveBlogPosting'; } catch(e) { return false; }
        });
        if (hasLiveBlog) {
            [].forEach.call(ldScripts, function(s) {
                try { if (JSON.parse(s.textContent)['@type'] === 'Article') s.parentNode.removeChild(s); } catch(e) {}
            });
        }
        {{#is "post"}}
        // En notas, Ghost emite "Article"; para Google News se reetiqueta como "NewsArticle".
        // Se reusa el JSON de Ghost (ya escapado correctamente) en vez de armarlo en Handlebars.
        else {
            [].forEach.call(ldScripts, function(s) {
                try {
                    var data = JSON.parse(s.textContent);
                    if (data['@type'] === 'Article') {
                        data['@type'] = 'NewsArticle';
                        s.textContent = JSON.stringify(data);
                    }
                } catch(e) {}
            });
        }
        {{/is}}
    })();
    </script>

</head>
<body class="{{body_class}} has-{{#match @custom.title_font "Elegant serif"}}serif{{else match @custom.title_font "Consistent mono"}}mono{{else}}sans{{/match}}-title has-{{#match @custom.body_font "Elegant serif"}}serif{{else}}sans{{/match}}-body">

<div class="gh-viewport">
    
    {{> "components/navigation" navigationLayout=@custom.navigation_layout}}

    {{{body}}}
    
    {{> "components/footer"}}
    
</div>

{{#is "post, page"}}
    {{> "lightbox"}}
{{/is}}

{{!-- Scripts - handle responsive videos, infinite scroll, and navigation dropdowns --}}
<script src="{{asset "built/source.js"}}"></script>

{{!-- Ghost outputs required functional scripts with this tag, it should always be the last thing before the closing body tag --}}
{{ghost_foot}}

<script>
(function () {
    var TRANSLATIONS = {
        'If you have an account, an email has been sent to': 'Si tienes una cuenta, se ha enviado un correo a',
        'Click the link inside or enter your code below.': 'Haz clic en el enlace o ingresa el código.',
        'Open Gmail': 'Abrir Gmail',
        'Open Inbox': 'Abrir bandeja de entrada',
        'Check your inbox': 'Revisa tu bandeja de entrada',
        'Already a member?': '¿Ya eres miembro?',
        'Manage your account': 'Gestionar cuenta',
        'View plans': 'Ver planes'
    };

    function translateNode(node) {
        if (node.nodeType !== Node.TEXT_NODE) return;
        var text = node.nodeValue;
        var changed = false;
        Object.keys(TRANSLATIONS).forEach(function (en) {
            if (text.indexOf(en) !== -1) {
                text = text.split(en).join(TRANSLATIONS[en]);
                changed = true;
            }
        });
        if (changed) node.nodeValue = text;
    }

    function translateTree(root) {
        if (!root) return;
        var walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
        var node;
        while ((node = walker.nextNode())) translateNode(node);
    }

    function observeDoc(doc) {
        if (!doc || !doc.body) return;
        translateTree(doc.body);
        new MutationObserver(function (mutations) {
            mutations.forEach(function (m) {
                m.addedNodes.forEach(function (n) {
                    if (n.nodeType === Node.ELEMENT_NODE) translateTree(n);
                });
                if (m.type === 'characterData') translateNode(m.target);
            });
        }).observe(doc.body, { childList: true, subtree: true, characterData: true });
    }

    function hookIframe(iframe) {
        function tryConnect() {
            try {
                var doc = iframe.contentDocument || iframe.contentWindow.document;
                if (doc && doc.body) {
                    observeDoc(doc);
                } else {
                    iframe.addEventListener('load', function () { observeDoc(iframe.contentDocument); });
                }
            } catch (e) {}
        }
        iframe.addEventListener('load', tryConnect);
        tryConnect();
    }

    new MutationObserver(function (mutations) {
        mutations.forEach(function (m) {
            m.addedNodes.forEach(function (n) {
                if (!n.nodeType || n.nodeType !== Node.ELEMENT_NODE) return;
                if (n.tagName === 'IFRAME') hookIframe(n);
                n.querySelectorAll('iframe').forEach(hookIframe);
            });
        });
    }).observe(document.body, { childList: true, subtree: true });

    document.querySelectorAll('iframe').forEach(hookIframe);
}());
</script>

</body>
</html>
