{{!< default}}

<style>
    :root, body { --background-color: #f1f2e9 !important; }
    body { background-color: var(--background-color) !important; }
    .gh-header-right .post-time {
        display: inline !important;
        visibility: visible !important;
        font-size: 0.9em !important;
    }
</style>

{{#if @custom.live_stream_video_id}}
    {{> "components/bloque-en-vivo"}}
{{/if}}

{{> "components/topbar-preview" variant="green"}}

{{!-- Balotaje Brasil 2026: aparece cuando algún post publicado tiene el tag interno #balotaje-brasil.
      order:-1 la sube encima del logo (igual que topbar-preview); al ir después en el DOM queda debajo de la barra de apps --}}
{{#get "posts" filter="tag:hash-balotaje-brasil" limit="1"}}
    {{#if posts}}
        <section class="gh-outer" style="order:-1;padding-top:20px;padding-bottom:4px">
            <div class="gh-inner">
                {{> "components/widget-balotaje-brasil" compact=true}}
            </div>
        </section>
    {{/if}}
{{/get}}

{{#match @custom.alert_bar_mode "!=" "Apagada"}}
    {{> "components/banner-alerta"}}
{{/match}}

{{> "components/header" headerStyle=@custom.header_style}}


