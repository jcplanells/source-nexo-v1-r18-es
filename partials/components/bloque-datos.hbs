<style>
    .bloque-datos {
        margin-top: 20px;
        padding-top: 20px;
        padding-bottom: 20px;
    }
    .bloque-datos .gh-container-title {
        margin-bottom: 30px;
        color: var(--color-base, #000);
        border-bottom: none;
    }
    .grid-bloque-datos {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr;
        gap: 32px;
        align-items: start;
    }
    /* Col 1: noticia destacada grande */
    .datos-card-featured img {
        width: 100%;
        aspect-ratio: 16/9;
        object-fit: cover;
        border-radius: 3px;
        margin-bottom: 14px;
    }
    .datos-card-featured h3 {
        font-size: clamp(2rem, 1.4vw + 1.4rem, 3.2rem);
        font-weight: 700;
        line-height: 1.15;
        letter-spacing: -0.02em;
        margin: 0;
    }
    .datos-card-featured h3 a {
        color: var(--color-base, #000);
        text-decoration: none;
    }
    .datos-card-featured .datos-featured-excerpt {
        margin: 10px 0 0;
        font-size: 1.5rem;
        line-height: 1.5;
        color: var(--color-secondary-text, #555);
    }
    .datos-meta {
        display: block;
        font-size: 1.3rem;
        color: var(--color-secondary-text, #888);
        margin-top: 8px;
    }
    .datos-card-mid .datos-meta {
        margin-top: 6px;
        font-size: 1.2rem;
    }
    /* Col 2: 2 notas medianas */
    .datos-posts-mid {
        display: flex;
        flex-direction: column;
        gap: 24px;
        position: relative;
        padding-left: 32px;
        border-left: 1px solid var(--color-border, #e5e7eb);
    }
    .datos-card-mid img {
        width: 100%;
        aspect-ratio: 16/9;
        object-fit: cover;
        border-radius: 3px;
        margin-bottom: 10px;
    }
    .datos-card-mid h3 {
        font-size: 1.8rem;
        line-height: 1.2;
        margin: 0;
    }
    .datos-card-mid h3 a {
        color: var(--color-base, #000);
        text-decoration: none;
    }
    /* Col 3: sidebar últimas / más leídas */
    .datos-sidebar {
        padding-left: 32px;
        border-left: 1px solid var(--color-border, #e5e7eb);
    }
    .datos-tabs {
        display: flex;
        gap: 16px;
        margin-bottom: 16px;
        border-bottom: 1px solid var(--color-border, #e5e7eb);
        padding-bottom: 12px;
    }
    .datos-tab {
        background: none;
        border: none;
        cursor: pointer;
        font-size: 1.5rem;
        font-weight: 600;
        color: #888;
        padding: 0;
        padding-bottom: 4px;
        border-bottom: 2px solid transparent;
        transition: color 0.2s, border-color 0.2s;
    }
    .datos-tab.is-active {
        color: var(--color-base, #000);
        border-bottom-color: var(--ghost-accent-color);
    }
    .datos-feed {
        display: flex;
        flex-direction: column;
        gap: 0;
    }
    .datos-feed .gh-card-link {
        display: flex;
        flex-direction: row;
        align-items: flex-start;
        gap: 12px;
        padding: 12px 0;
        border-bottom: 1px solid var(--color-border, #e5e7eb);
        text-decoration: none;
        color: inherit;
    }
    .datos-feed .gh-card-image {
        flex-shrink: 0;
        width: 72px;
        height: 54px;
        object-fit: cover;
        border-radius: 3px;
    }
    .datos-feed .gh-card-title {
        font-size: 1.4rem;
        line-height: 1.3;
        font-weight: 600;
        margin: 0;
        color: var(--color-base, #000);
    }
    .datos-feed .gh-leidas-num {
        color: var(--ghost-accent-color);
        font-weight: 700;
        margin-right: 4px;
    }
    .datos-feed-loading {
        font-size: 1.4rem;
        color: #888;
        padding: 12px 0;
    }
    /* Mostrar hora en "Las Últimas" del sidebar */
    .datos-sidebar .post-time {
        display: inline !important;
        font-weight: 600;
    }
    @media (max-width: 991px) {
        .grid-bloque-datos {
            grid-template-columns: 1fr 1fr;
        }
        .datos-sidebar {
            grid-column: 1 / -1;
            padding-left: 0;
            border-left: none;
            border-top: 1px solid var(--color-border, #e5e7eb);
            padding-top: 24px;
        }
        .datos-feed {
            flex-direction: row;
            flex-wrap: wrap;
            gap: 16px;
        }
        .datos-feed .gh-card-link {
            flex: 1 1 calc(50% - 8px);
            border-bottom: none;
        }
    }
    @media (max-width: 767px) {
        .grid-bloque-datos {
            grid-template-columns: 1fr;
        }
        .datos-posts-mid {
            padding-left: 0;
            border-left: none;
        }
        .datos-card-mid {
            display: flex;
            flex-direction: row;
            gap: 12px;
            align-items: flex-start;
        }
        .datos-card-mid > a {
            flex-shrink: 0;
            width: 110px;
        }
        .datos-card-mid img {
            width: 100%;
            aspect-ratio: 16/9;
            margin-bottom: 0;
        }
        .datos-mid-text {
            flex: 1;
            min-width: 0;
        }
        .datos-feed {
            flex-direction: column;
        }
        .datos-feed .gh-card-link {
            flex: none;
            border-bottom: 1px solid var(--color-border, #e5e7eb);
        }
    }
</style>

<section class="gh-outer bloque-datos">
    <div class="gh-inner">
        <h2 class="gh-container-title">
            <span style="border-bottom: 3px solid var(--ghost-accent-color); padding-bottom: 9px;">
                <a href="https://nexo.la/tag/datos/" style="text-decoration: none; color: inherit;">Últimos datos de nexo</a>
            </span>
        </h2>

        <div class="grid-bloque-datos">

            {{#get "posts" filter="tag:datos" limit="3" include="authors"}}
                {{!-- Col 1: noticia grande --}}
                {{#foreach posts}}
                    {{#if @first}}
                        <article class="datos-card-featured">
                            {{#if feature_image}}
                                <a href="{{url}}">
                                    <img src="{{feature_image}}" alt="{{title}}">
                                </a>
                            {{/if}}
                            <h3><a href="{{url}}">{{title}}</a></h3>
                            {{#if custom_excerpt}}
                                <p class="datos-featured-excerpt">{{custom_excerpt}}</p>
                            {{else}}
                                {{#if excerpt}}
                                    <p class="datos-featured-excerpt">{{excerpt}}</p>
                                {{/if}}
                            {{/if}}
                            <span class="datos-meta">{{reading_time minute="1 min de lectura" minutes="% min de lectura"}}</span>
                        </article>
                    {{/if}}
                {{/foreach}}

                {{!-- Col 2: notas 2 y 3 --}}
                <div class="datos-posts-mid">
                    {{#foreach posts}}
                        {{#unless @first}}
                            <article class="datos-card-mid">
                                {{#if feature_image}}
                                    <a href="{{url}}">
                                        <img src="{{feature_image}}" alt="{{title}}">
                                    </a>
                                {{/if}}
                                <div class="datos-mid-text">
                                    <h3><a href="{{url}}">{{title}}</a></h3>
                                    <span class="datos-meta">{{reading_time minute="1 min de lectura" minutes="% min de lectura"}}</span>
                                </div>
                            </article>
                        {{/unless}}
                    {{/foreach}}
                </div>
            {{/get}}

            {{!-- Col 3: Las Últimas / Más leídas --}}
            <div class="datos-sidebar">
                <div class="datos-tabs">
                    <button class="datos-tab is-active" data-datos-tab="ultimas">Las Últimas</button>
                    <button class="datos-tab" data-datos-tab="leidas">Más leídas</button>
                </div>
                <div class="datos-feed" id="datos-feed">
                    {{#get "posts" filter="tag:-[hash-top1,hash-top2]" include="authors" limit="6" order="published_at desc"}}
                        {{#foreach posts}}
                            <a class="gh-card-link" href="{{url}}?utm_source=nexo&utm_medium=home&utm_campaign=las_ultimas">
                                <div class="gh-card-wrapper">
                                    <h3 class="gh-card-title"><span class="post-time">{{date published_at format="h:mm a"}}</span> — {{title}}</h3>
                                </div>
                                {{#if feature_image}}
                                    <img class="gh-card-image" src="{{img_url feature_image size="xs"}}" alt="{{title}}">
                                {{/if}}
                            </a>
                        {{/foreach}}
                    {{/get}}
                </div>
            </div>

        </div>

        <div style="text-align: right; margin-top: 15px;">
            <a href="https://nexo.la/tag/datos/" style="color: var(--ghost-accent-color); font-weight: bold; text-decoration: none;">ver más...</a>
        </div>
    </div>
</section>

<script>
(function () {
    var GHOST_URL = 'https://nexo-la.ghost.io';
    var GHOST_KEY = '4814aa41c8315fc5648524c04c';
    var feed = document.getElementById('datos-feed');
    var tabs = document.querySelectorAll('.datos-tab');
    var ultimasHTML = feed ? feed.innerHTML : '';
    var leidasHTML = null;

    tabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
            if (tab.classList.contains('is-active')) return;
            tabs.forEach(function (t) { t.classList.remove('is-active'); });
            tab.classList.add('is-active');

            if (tab.dataset.datosTab === 'ultimas') {
                feed.innerHTML = ultimasHTML;
                return;
            }

            if (leidasHTML) { feed.innerHTML = leidasHTML; return; }

            feed.innerHTML = '<p class="datos-feed-loading">Cargando...</p>';

            fetch('https://opt.nexo.la/assets/json/mas_leidas.json')
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    var items = data[0] && data[0].top;
                    if (!items || !items.length) throw new Error();
                    var slugs = items.filter(function (item) {
                        return item.url.indexOf('/tag/') === -1;
                    }).slice(0, 6).map(function (item) {
                        return item.url.split('?')[0].replace(/\/$/, '').split('/').pop();
                    });
                    return fetch(GHOST_URL + '/ghost/api/content/posts/?key=' + GHOST_KEY +
                        '&filter=' + encodeURIComponent('slug:[' + slugs.join(',') + ']') +
                        '&include=tags&fields=title,slug,url,feature_image,primary_tag,published_at&limit=6')
                        .then(function (r) { return r.json(); })
                        .then(function (ghost) {
                            var posts = ghost.posts;
                            if (!posts || !posts.length) throw new Error();
                            var map = {};
                            posts.forEach(function (p) { map[p.slug] = p; });
                            var html = '';
                            var num = 0;
                            slugs.forEach(function (slug) {
                                var p = map[slug];
                                if (!p) return;
                                num++;
                                var jsonItem = items.find(function (i) { return i.url.indexOf(slug) !== -1; });
                                var base = jsonItem ? jsonItem.url : p.url;
                                var url = base + (base.indexOf('?') !== -1 ? '&' : '?') + 'utm_source=nexo&utm_medium=home&utm_campaign=mas_leidas';
                                html += '<a class="gh-card-link" href="' + url + '">' +
                                    '<div class="gh-card-wrapper">' +
                                    '<h3 class="gh-card-title"><span class="gh-leidas-num">' + num + '</span> ' + p.title + '</h3>' +
                                    '</div>' +
                                    (p.feature_image ? '<img class="gh-card-image" src="' + p.feature_image + '" alt="' + p.title.replace(/"/g, '&quot;') + '" loading="lazy">' : '') +
                                    '</a>';
                            });
                            leidasHTML = html;
                            feed.innerHTML = html;
                        });
                })
                .catch(function () {
                    tabs.forEach(function (t) { t.classList.remove('is-active'); });
                    document.querySelector('.datos-tab[data-datos-tab="ultimas"]').classList.add('is-active');
                    feed.innerHTML = ultimasHTML;
                });
        });
    });
}());
</script>
