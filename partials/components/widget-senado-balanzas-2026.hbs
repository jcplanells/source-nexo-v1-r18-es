      var c=ST[s],el=document.createElement('div');el.className='bz-card'+(filt===s?' sel':'');el.setAttribute('data-st',s);el.setAttribute('role','button');el.setAttribute('tabindex','0');el.setAttribute('aria-label','Ver las noticias de '+c.n);el.setAttribute('aria-pressed',filt===s);
      el.innerHTML=cardHTML(s);
      el.addEventListener('click',function(){pickState(s)});el.addEventListener('keydown',function(ev){if(ev.key==='Enter'||ev.key===' '){ev.preventDefault();pickState(s)}});
      g.appendChild(el);
      cards.push({s:s,el:el,target:0,ang:0,vel:0,h:{l:{a:0,v:0},r:{a:0,v:0}},geo:null});
    });
    layout();if(last)render(last);g.scrollLeft=0;dots();
  }
  function layout(){allC().forEach(layoutC)}
  function layoutC(C){
      var st=C.el.querySelector('.bz-stage'),W=st.clientWidth||340,H=C.big?Math.round(Math.max(200,Math.min(320,W*.6))):W<=340?Math.round(Math.max(96,Math.min(150,W*.62))):Math.round(Math.max(140,Math.min(160,W*.44)));
      st.style.setProperty('--sh',H+'px');
      var mini=!C.big&&W<=340,half=W*.36,figH=C.big?Math.min(H*.72,W*.42):mini?Math.min(H*.66,W*.5):Math.min(H*.7,W*.40),pivotY=H-(mini?14:C.big?34:24),ppt=C.big?Math.min(5,(H*.3)/8*.6):mini?Math.min(2,(H*.3)/8*.6):Math.min(3.2,(H*.30)/8*.6);
      C.mini=mini;
      C.geo={W:W,H:H,half:half,figH:figH,pivotY:pivotY,ppt:ppt};
      var b=C.el.querySelector('.bz-beam');b.style.width=(half*2)+'px';b.style.marginLeft=(-half)+'px';b.style.top=(pivotY-4)+'px';
      C.el.querySelector('.bz-pin').style.top=(pivotY-8)+'px';
      var f=C.el.querySelector('.bz-ful');f.style.top=pivotY+'px';f.style.borderBottomWidth=(H-pivotY)+'px';
      C.el.querySelector('.bz-sl').style.left='14%';C.el.querySelector('.bz-sr').style.left='86%';
      ['l','r'].forEach(function(sd){var fg=C.el.querySelector('.bz-f'+sd),w=figH*FIGS[fg.getAttribute('data-k')].ar;fg.style.width=w+'px';fg.style.height=figH+'px';fg.style.left=(-w/2)+'px';});
      paint(C);
  }
  function angFor(C,half){var dy=Math.max(-8,Math.min(8,half))*C.geo.ppt;return Math.asin(Math.max(-1,Math.min(1,dy/(C.geo.half*.74))))*180/Math.PI;}
  function paint(C){
    var g=C.geo;if(!g)return;C.el.querySelector('.bz-beam').style.transform='rotate('+C.ang+'deg)';
    ['l','r'].forEach(function(sd){var f=C.el.querySelector('.bz-f'+sd);f.style.transform='rotate('+(-C.ang)+'deg)';f.querySelector('.bz-hd').style.transform='rotate('+C.h[sd].a+'deg)';});
    var rad=C.ang*Math.PI/180,hx=g.half*.74,ys=Math.sin(rad)*hx,dd=C.el.querySelector('.bz-dd'),dr=C.el.querySelector('.bz-dr');
    dd.style.left=Math.max(22,g.W/2-hx-g.figH*.32)+'px';dd.style.top=Math.max(12,g.pivotY-ys-g.figH*.55)+'px';
    dr.style.left=Math.min(g.W-22,g.W/2+hx+g.figH*.32)+'px';dr.style.top=Math.max(12,g.pivotY+ys-g.figH*.55)+'px';
  }
  function frame(now){
    var dt=Math.min(.05,(now-(frame.p||now))/1000);frame.p=now;
    if(visible) allC().forEach(function(C,i){
      if(reduce){C.ang=C.target;C.vel=0;}else{var a=-38*(C.ang-C.target)-7.5*C.vel;C.vel+=a*dt;C.ang+=C.vel*dt;}
      ['l','r'].forEach(function(sd,j){var h=C.h[sd],idle=reduce?0:Math.sin(now/900+i*1.3+j*1.7)*1.6;h.v+=(-120*(h.a-idle)-5*h.v)*dt;h.a+=h.v*dt;});
      paint(C);});
    requestAnimationFrame(frame);
  }
  function kick(C,m){if(reduce)return;['l','r'].forEach(function(sd,i){C.h[sd].v+=(i?-1:1)*m*(.8+Math.random()*.4);});}

  function pick(s){ /* conteo de un estado desde civicAPI, por nombre exacto (en Alaska hay otro "Daniel J. Sullivan") */
    var reg=data[s.toLowerCase()],c=ST[s],o={d:0,r:0,dv:0,rv:0,p:null,any:false};if(!reg)return o;
    (reg.candidates||[]).forEach(function(x){if(x.name===c.D[1]){o.d=+x.percent||0;o.dv=+x.votes||0}if(x.name===c.R[1]){o.r=+x.percent||0;o.rv=+x.votes||0}});
    o.p=reg.percent_reporting!=null?Math.round(reg.percent_reporting):null;o.any=(o.dv+o.rv)>0;return o;
  }
  function callOf(s){var c=(AP.senado||{})[s];c=c&&typeof c==='object'?c.c:c;return c==='D'||c==='R'?c:null;} /* ap.json: "senado": {"TX": "R"} */
  var pf=function(x){return x.toFixed(1)+'%'},sg=function(v){return(v>0?'+':v<0?'−':'±')+Math.abs(v).toFixed(1)};
  function render(){
    last=1;var anyAll=false,fin=!!AP.final;
    allC().forEach(function(C){
      var s=C.s,c=ST[s],o=pick(s),call=callOf(s),e=C.el,diff=o.d-o.r,half=diff/2;anyAll=anyAll||o.any||!!call;
      e.querySelector('.bz-pd').textContent=o.any?pf(o.d):'–';e.querySelector('.bz-pr').textContent=o.any?pf(o.r):'–';
      e.querySelector('.bz-df').textContent=o.any?Math.abs(diff).toFixed(1)+' pts':'–';
      var tot=(o.d+o.r)||100;e.querySelector('.bz-bd-d').style.width=(o.any?o.d/tot*100:50)+'%';e.querySelector('.bz-bd-r').style.width=(o.any?o.r/tot*100:50)+'%';
      var dd=e.querySelector('.bz-dd'),dr=e.querySelector('.bz-dr');
      if(o.any){dd.textContent=sg(half);dr.textContent=sg(-half);dd.style.opacity=dr.style.opacity=1}else{dd.style.opacity=dr.style.opacity=0}
      e.querySelector('.bz-wait').textContent=(o.any||call)?'':(!!C.mini?c.cl.replace('Cierre: ',''):c.cl.replace('Cierre:','Las urnas cierran a las')+' (hora de Panamá).');
      var cl=e.querySelector('.bz-call');var mn=!!C.mini,nm=function(n){return mn?ln(n):n};cl.textContent=call==='D'?'AP: gana '+nm(c.D[1]):call==='R'?'AP: gana '+nm(c.R[1]):'';cl.style.background=call==='D'?'var(--d)':'var(--r)';
      e.classList.toggle('wd',call==='D');e.classList.toggle('wr',call==='R');
      var mnc=!!C.mini,clx=e.querySelector('.bz-cl'),esc=o.any&&o.p!=null;
      clx.textContent=esc?o.p+'% escrutado':(mnc?c.cl.replace('Cierre: ',''):c.cl);clx.classList.toggle('on',esc);e.querySelector('.bz-pg i').style.width=(esc?o.p:0)+'%';
      e.querySelector('.bz-ft').textContent=(o.p!=null&&o.any?o.p+'% escrutado. ':'')+NOTE[s];
      var t=o.any?angFor(C,half):0;if(Math.abs(t-C.target)>.01)kick(C,Math.min(60,10+Math.abs(t-C.target)*25));C.target=t;
    });
    q('#nxbz-live').classList.toggle('on',anyAll&&!fin);q('#nxbz-lt').textContent=fin?'Final':anyAll?'En vivo':'Antes del cierre';
    feed();
  }
  var filt=null,focoC=null;
  function allC(){return focoC?cards.concat([focoC]):cards}
  function foco(){ /* tarjeta grande del estado elegido, arriba del minuto a minuto */
    var box=q('#nxbz-foco');box.innerHTML='';focoC=null;if(!filt)return;
    var el=document.createElement('div');el.className='bz-card big';el.setAttribute('data-st',filt);el.innerHTML=cardHTML(filt);box.appendChild(el);
    focoC={s:filt,el:el,big:true,target:0,ang:0,vel:0,h:{l:{a:0,v:0},r:{a:0,v:0}},geo:null};
    layoutC(focoC);render();kick(focoC,40);
  }
  function setOpen(open){var tg=q('#nxbz-tg'),mp=q('#nxbz-mapa');tg.setAttribute('aria-expanded',open);q('#nxbz-detail').hidden=!open;root.classList.toggle('open',open);
    var nb=mp.querySelector('#nxeu-toggle');if(open&&nb&&nb.getAttribute('aria-expanded')!=='true')nb.click();
    tg.firstChild.textContent=open?'Cerrar':'Ver todo en vivo';}
  function pickState(s){ /* tocar una tarjeta: abre el panel y filtra el minuto a minuto a ese estado; otra vez, quita el filtro */
    filt=(filt===s)?null:s;
    cards.forEach(function(C){var on=C.s===filt;C.el.classList.toggle('sel',on);C.el.setAttribute('aria-pressed',on)});
    if(filt)setOpen(true);foco();
    feed();if(filt){var f=q('#nxbz-foco');if(f&&f.scrollIntoView)f.scrollIntoView({behavior:reduce?'auto':'smooth',block:'nearest'})}
  }
  function enEstado(x,s){if(x.st)return x.st===s;var n=ST[s].n;return String(x.t).indexOf(n)>-1||String(x.t).indexOf(n.replace('í','i'))>-1}
  var seen={};
  function esc(t){return String(t).replace(/[&<>"]/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]})}
  function feed(){
    var ALL=(AP.minuto||[]).slice(0,80),L=filt?ALL.filter(function(x){return enEstado(x,filt)}):ALL,ol=q('#nxbz-feed'),first=!ol.childElementCount;
    var fx=q('#nxbz-fx');fx.classList.toggle('on',!!filt);
    if(filt){var o=pick(filt);q('#nxbz-fxn').textContent=ST[filt].n;
      q('#nxbz-fxt').textContent=(o.any&&o.p!=null?o.p+'% escrutado. ':ST[filt].cl+' (hora de Panamá). ')+NOTE[filt];}
    if(!L.length&&filt){ol.innerHTML='<li class="vacio">Todavía no hay noticias de '+esc(ST[filt].n)+'.</li>';}
    else if(!L.length){ol.innerHTML='<li class="vacio">Aquí van los cierres de urnas, los cambios de punta y las proyecciones de AP, hora por hora y minuto a minuto. Arranca a las 6:00 p.m. de Panamá.</li>';}
    if(!L.length){if(!ALL.length)return;var u0=ALL[0];q('#nxbz-last').innerHTML='<b>'+esc(u0.h)+'</b> · '+(u0.st&&ST[u0.st]?esc(ST[u0.st].n)+': ':'')+esc(u0.t);return}
    ol.innerHTML=L.map(function(x){var key=x.h+'|'+x.t,nu=!first&&!seen[key];seen[key]=1;
      var tag=x.st&&ST[x.st]?'<span class="k '+(x.p==='D'||x.p==='R'?x.p:'')+'">'+esc(ST[x.st].n)+'</span>':'';
      return '<li'+(nu?' class="new"':'')+'><time>'+esc(x.h)+'</time><div>'+tag+esc(x.t)+'</div></li>'}).join('');
    var u=ALL[0];q('#nxbz-last').innerHTML='<b>'+esc(u.h)+'</b> · '+(u.st&&ST[u.st]?esc(ST[u.st].n)+': ':'')+esc(u.t);
  }
  function dots(){ /* puntos y flechas según cuántas tarjetas caben y dónde va el deslizamiento */
    var g=q('#nxbz-grid'),c=g.querySelector('.bz-card');if(!c)return;var w=c.getBoundingClientRect().width+parseFloat(getComputedStyle(g).columnGap||10),
      vis=Math.max(1,Math.round((g.clientWidth-10)/w)),pages=Math.max(1,Math.ceil(cards.length-vis)+1),i=Math.round(g.scrollLeft/w);
    q('#nxbz-dots').innerHTML=new Array(pages+1).join('<i></i>');var ds=q('#nxbz-dots').children;if(ds[Math.min(i,pages-1)])ds[Math.min(i,pages-1)].className='on';
    q('#nxbz-prev').hidden=g.scrollLeft<4;q('#nxbz-next').hidden=g.scrollLeft+g.clientWidth>=g.scrollWidth-4;
  }
  function paso(dir){var g=q('#nxbz-grid'),c=g.querySelector('.bz-card');if(!c)return;g.scrollBy({left:dir*(c.getBoundingClientRect().width+parseFloat(getComputedStyle(g).columnGap||10)),behavior:reduce?'auto':'smooth'});setTimeout(dots,120);setTimeout(dots,600)}
  var userPick=urlBz.length===3;
  q('#nxbz-grid').addEventListener('scroll',function(){clearTimeout(dots.t);dots.t=setTimeout(dots,60)},{passive:true});
  q('#nxbz-prev').addEventListener('click',function(){paso(-1)});q('#nxbz-next').addEventListener('click',function(){paso(1)});
  function load(){
    clearTimeout(timer);if(document.visibilityState==='hidden')return schedule();
    var jobs=[fetch(CIVIC,{cache:'no-store'}).then(function(r){if(!r.ok)throw 0;return r.json()}).then(function(j){data=j.region_results||{};var t=new Date(j.last_updated);
      if(!isNaN(t))q('#nxbz-fupd').textContent='Conteo actualizado a las '+t.toLocaleTimeString('es-PA',{hour:'numeric',minute:'2-digit',timeZone:'America/Panama'})+'.';}).catch(function(){})];
    if(tick++%2===0)jobs.push(fetch(AP_URL,{cache:'no-store',credentials:'omit'}).then(function(r){if(!r.ok)throw 0;return r.text()}).then(function(t){
      var m=t.match(/<script type="application\/json" id="nxeu-ap">([\s\S]*?)<\/script>/);if(!m)return;AP=JSON.parse(m[1]);
      var p=(AP.portada||[]).map(function(s){return String(s).toUpperCase()}).filter(function(s){return ST[s]});
      if(p.length===3&&!userPick&&orden(p).join()!==front.join()){front=orden(p);build();}}).catch(function(){}));
    Promise.all(jobs).then(function(){render();schedule()});
  }
  function schedule(){clearTimeout(timer);if(AP.final)return;timer=setTimeout(load,30000+Math.random()*10000);}
  document.addEventListener('visibilitychange',function(){if(document.visibilityState==='visible'&&!AP.final)load()});
  if('IntersectionObserver' in window)new IntersectionObserver(function(es){visible=es[0].isIntersecting}).observe(root);
  window.addEventListener('resize',function(){clearTimeout(layout.t);layout.t=setTimeout(function(){layout();dots()},120)});
  var tg=q('#nxbz-tg'),dt=q('#nxbz-detail'),mp=q('#nxbz-mapa');
  tg.addEventListener('click',function(){var open=tg.getAttribute('aria-expanded')!=='true';setOpen(open);if(!open&&filt)pickState(filt);});
  q('#nxbz-fxc').addEventListener('click',function(){if(filt)pickState(filt)});
  root.__demo=function(d,ap){data=d||{};AP=ap||{};if(AP.portada&&orden(AP.portada).join()!==front.join()){front=orden(AP.portada);build();}render();};
  build();requestAnimationFrame(frame);
  if(!window.NXBZ_PREVIEW)load();
})();
</script>
</div>
