<style>
    .bloque-logistica {
        padding-top: 20px;
        padding-bottom: 20px;
        margin-top: 20px;
    }
    .bloque-logistica .gh-container-title {
        margin-bottom: 30px;
        color: var(--color-base, #000);
        border-bottom: none;
    }
    .grid-bloque-logistica {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 32px;
    }
    @media (max-width: 991px) {
        .grid-bloque-logistica {
            grid-template-columns: repeat(2, 1fr);
        }
    }
    @media (max-width: 767px) {
        .grid-bloque-logistica {
            grid-template-columns: 1fr;
        }
    }
    .card-bloque-logistica img {
        width: 100%;
        aspect-ratio: 16/9;
        object-fit: cover;
        border-radius: 3px;
        margin-bottom: 12px;
    }
    .card-bloque-logistica h3 {
        font-size: 1.8rem;
        line-height: 1.2;
        margin: 0;
    }
    .card-bloque-logistica h3 a {
        color: var(--color-base, #000);
        text-decoration: none;
    }
</style>
<section class="gh-outer bloque-logistica">
    <div class="gh-inner">
            <h2 class="gh-container-title">
                <span style="border-bottom: 3px solid var(--ghost-accent-color); padding-bottom: 9px;">
                    <a href="https://nexo.la/tag/logistica/" style="text-decoration: none; color: inherit;">Logística</a>
                </span>
            </h2>

            <div class="grid-bloque-logistica">
                {{#get "posts" filter="tag:logistica" limit="8" include="authors"}}
                    {{#foreach posts from="5"}}
                        <article class="card-bloque-logistica">
                            {{#if feature_image}}
                                <a href="{{url}}">
                                    <img src="{{feature_image}}" alt="{{title}}">
                                </a>
                            {{/if}}
                            <h3>
                                <a href="{{url}}">{{title}}</a>
                            </h3>
                        </article>
                    {{/foreach}}
                {{/get}}
            </div>
            <div style="text-align: right; margin-top: 15px;">
                <a href="https://nexo.la/tag/logistica/" style="color: var(--ghost-accent-color); font-weight: bold; text-decoration: none;">ver más...</a>
            </div>
    </div>
</section>