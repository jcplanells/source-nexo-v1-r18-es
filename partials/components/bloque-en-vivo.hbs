<style>
.bloque-en-vivo {
    background: #0a0a0a;
    padding: 24px 0;
}
.bloque-en-vivo-inner {
    max-width: 900px;
    margin: 0 auto;
}
.bloque-en-vivo-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
}
.bloque-en-vivo-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: 'DM Sans', sans-serif;
    font-size: 1.1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #fff;
    background: #e63946;
    padding: 4px 10px;
    border-radius: 4px;
}
.bloque-en-vivo-badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #fff;
    animation: bloque-en-vivo-pulse 1.4s ease-in-out infinite;
}
@keyframes bloque-en-vivo-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
}
.bloque-en-vivo-player {
    position: relative;
    width: 100%;
    aspect-ratio: 16/9;
    background: #000;
    border-radius: 4px;
    overflow: hidden;
}
.bloque-en-vivo-player iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
}
</style>

<section class="gh-outer bloque-en-vivo">
    <div class="gh-inner bloque-en-vivo-inner">
        <div class="bloque-en-vivo-header">
            <span class="bloque-en-vivo-badge"><span class="bloque-en-vivo-badge-dot"></span> En vivo</span>
        </div>
        <div class="bloque-en-vivo-player">
            <iframe
                src="https://www.youtube.com/embed/{{@custom.live_stream_video_id}}?autoplay=1&mute=1&rel=0"
                title="Transmisión en vivo"
                frameborder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                referrerpolicy="strict-origin-when-cross-origin"
                allowfullscreen>
            </iframe>
        </div>
    </div>
</section>
