<style>
    .bloque-logistica-preview {
        padding-top: 20px;
        padding-bottom: 20px;
        margin-top: 20px;
    }
    .bloque-logistica-preview .gh-container-title {
        margin-bottom: 30px;
        color: var(--color-base, #000);
        border-bottom: none;
    }
    .grid-bloque-logistica-preview {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 32px;
        align-items: start;
    }
    /* Noticia destacada: ocupa columnas 1-2 */
    .card-logistica-featured {
        grid-column: span 2;
    }
    .card-logistica-featured img {
        width: 100%;
        aspect-ratio: 16/9;
        object-fit: cover;
        border-radius: 3px;
        margin-bottom: 14px;
    }
    .card-logistica-featured h3 {
        font-size: 2.4rem;
        line-height: 1.2;
        margin: 0;
    }
    .card-logistica-featured h3 a {
        color: var(--color-base, #000);
        text-decoration: none;
    }
    .card-logistica-featured .featured-excerpt {
        display: -webkit-box;
        -webkit-line-clamp: 4;
        -webkit-box-orient: vertical;
        overflow: hidden;
        font-size: 1.5rem;
        line-height: 1.6;
        color: #555;
        margin: 12px 0 8px;
    }
    .card-logistica-featured .featured-meta {
        font-size: 1.3rem;
        color: #888;
    }
    /* Columna 3: 3 notas apiladas */
    .col-logistica-notas {
        display: flex;
        flex-direction: column;
        gap: 18px;
    }
    .card-logistica-nota img {
        width: 100%;
        aspect-ratio: 16/9;
        object-fit: cover;
        border-radius: 3px;
        margin-bottom: 8px;
    }
    .card-logistica-nota h3 {
        font-size: 1.5rem;
        line-height: 1.2;
        margin: 0;
    }
    .card-logistica-nota h3 a {
        color: var(--color-base, #000);
        text-decoration: none;
    }
    /* Columna 4: 5ª nota + widget niveles */
    .col-logistica-widget {
        align-self: stretch;
        display: flex;
        flex-direction: column;
    }
    .col-logistica-widget .card-logistica-nota {
        margin-bottom: 20px;
    }
    /* Columna 4: widget niveles reducido y centrado en espacio restante */
    .col-logistica-widget .widget-niveles {
        flex: 1;
        justify-content: flex-start;
        align-items: center;
    }
    .col-logistica-widget .widget-niveles-card {
        max-width: 100% !important;
        padding: 16px !important;
        border-radius: 16px !important;
    }
    .col-logistica-widget .titulo-principal h1 {
        font-size: 1.2rem !important;
    }
    .col-logistica-widget .contenedor-lagos {
        gap: 10px !important;
        margin-top: 12px !important;
    }
    .col-logistica-widget .tank-container {
        width: 65px !important;
    }
    .col-logistica-widget .scale-labels {
        width: 24px !important;
    }
    .col-logistica-widget .lake-title {
        font-size: 1rem !important;
    }
    .col-logistica-widget .color-bar {
        width: 8px !important;
    }
    @media (max-width: 991px) {
        .grid-bloque-logistica-preview {
            grid-template-columns: repeat(2, 1fr);
        }
        .card-logistica-featured {
            grid-column: span 2;
        }
    }
    @media (max-width: 767px) {
        .grid-bloque-logistica-preview {
            grid-template-columns: 1fr;
        }
        .card-logistica-featured {
            grid-column: span 1;
        }
        .card-logistica-nota {
            display: flex;
            flex-direction: row;
            gap: 12px;
            align-items: flex-start;
        }
        .card-logistica-nota > a {
            flex-shrink: 0;
            width: 110px;
        }
        .card-logistica-nota img {
            width: 100%;
            aspect-ratio: 16/9;
            margin-bottom: 0;
        }
        .card-logistica-nota h3 {
            flex: 1;
        }
        .col-logistica-widget .widget-niveles-card {
            margin-top: 8px;
        }
    }
</style>

<section class="gh-outer bloque-logistica-preview">
    <div class="gh-inner">
        <h2 class="gh-container-title">
            <span style="border-bottom: 3px solid var(--ghost-accent-color); padding-bottom: 9px;">
                <a href="https://nexo.la/tag/logistica/" style="text-decoration: none; color: inherit;">Logística</a>
            </span>
        </h2>

        <div class="grid-bloque-logistica-preview">
            {{#get "posts" filter="primary_tag:logistica" limit="5" include="authors"}}
                {{!-- Noticia destacada: primera entrada, ocupa columnas 1-2 --}}
                {{#foreach posts}}
                    {{#if @first}}
                        <article class="card-logistica-featured">
                            {{#if feature_image}}
                                <a href="{{url}}">
                                    <img src="{{feature_image}}" alt="{{title}}">
                                </a>
                            {{/if}}
                            <h3><a href="{{url}}">{{title}}</a></h3>
                            <p class="featured-excerpt">{{excerpt}}</p>
                            <span class="featured-meta">{{reading_time minute="1 min de lectura" minutes="% min de lectura"}}</span>
                        </article>
                    {{/if}}
                {{/foreach}}

                {{!-- Columna 3: notas 2, 3 y 4 (ni primera ni última) --}}
                <div class="col-logistica-notas">
                    {{#foreach posts}}
                        {{#unless @first}}
                            {{#unless @last}}
                                <article class="card-logistica-nota">
                                    {{#if feature_image}}
                                        <a href="{{url}}">
                                            <img src="{{feature_image}}" alt="{{title}}">
                                        </a>
                                    {{/if}}
                                    <h3><a href="{{url}}">{{title}}</a></h3>
                                </article>
                            {{/unless}}
                        {{/unless}}
                    {{/foreach}}
                </div>

                {{!-- Columna 4: 5ª nota + widget de niveles --}}
                <div class="col-logistica-widget">
                    {{#foreach posts}}
                        {{#if @last}}
                            <article class="card-logistica-nota">
                                {{#if feature_image}}
                                    <a href="{{url}}">
                                        <img src="{{feature_image}}" alt="{{title}}">
                                    </a>
                                {{/if}}
                                <h3><a href="{{url}}">{{title}}</a></h3>
                            </article>
                        {{/if}}
                    {{/foreach}}
                    {{> "components/widget-niveles"}}
                </div>
            {{/get}}
        </div>

        <div style="text-align: right; margin-top: 15px;">
            <a href="https://nexo.la/tag/logistica/" style="color: var(--ghost-accent-color); font-weight: bold; text-decoration: none;">ver más...</a>
        </div>
    </div>
</section>
