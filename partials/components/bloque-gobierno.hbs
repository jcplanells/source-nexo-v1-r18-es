<style>
    .bloque-gobierno {
        padding-top: 20px;
        padding-bottom: 20px;
        margin-top: 20px;
    }
    .bloque-gobierno .gh-container-title {
        margin-bottom: 30px;
        color: var(--color-base, #000);
        border-bottom: none;
    }
    .grid-bloque-gobierno {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 32px;
    }
    @media (max-width: 991px) {
        .grid-bloque-gobierno {
            grid-template-columns: repeat(2, 1fr);
        }
    }
    @media (max-width: 767px) {
        .grid-bloque-gobierno {
            grid-template-columns: 1fr;
        }
        .card-bloque-gobierno.is-nota {
            display: flex;
            flex-direction: row;
            gap: 12px;
            align-items: flex-start;
        }
        .card-bloque-gobierno.is-nota > a {
            flex-shrink: 0;
            width: 110px;
        }
        .card-bloque-gobierno.is-nota img {
            width: 100%;
            aspect-ratio: 16/9;
            margin-bottom: 0;
        }
        .card-bloque-gobierno.is-nota .gobierno-text {
            flex: 1;
            min-width: 0;
        }
    }
    .card-bloque-gobierno img {
        width: 100%;
        aspect-ratio: 16/9;
        object-fit: cover;
        border-radius: 3px;
        margin-bottom: 12px;
    }
    .card-bloque-gobierno h3 {
        font-size: 1.8rem;
        line-height: 1.2;
        margin: 0;
    }
    .card-bloque-gobierno h3 a {
        color: var(--color-base, #000);
        text-decoration: none;
    }
    .card-bloque-gobierno .gobierno-meta {
        display: block;
        font-size: 1.2rem;
        color: var(--color-secondary-text, #888);
        margin-top: 6px;
    }
</style>
<section class="gh-outer bloque-gobierno">
    <div class="gh-inner">
        <h2 class="gh-container-title">
            <span style="border-bottom: 3px solid var(--ghost-accent-color); padding-bottom: 9px;">
                <a href="{{@site.url}}/tag/gobierno/" style="text-decoration: none; color: inherit;">Gobierno</a>
            </span>
        </h2>
        <div class="grid-bloque-gobierno">
            {{#get "posts" filter="primary_tag:gobierno" limit="4" include="tags,authors"}}
                {{#foreach posts}}
                    <article class="card-bloque-gobierno{{#unless @first}} is-nota{{/unless}}">
                        {{#if feature_image}}
                            <a href="{{url}}">
                                <img src="{{feature_image}}" alt="{{title}}">
                            </a>
                        {{/if}}
                        <div class="gobierno-text">
                            <h3>
                                <a href="{{url}}">{{title}}</a>
                            </h3>
                            <span class="gobierno-meta">{{reading_time minute="1 min de lectura" minutes="% min de lectura"}}</span>
                        </div>
                    </article>
                {{/foreach}}
            {{else}}
                <p style="grid-column: 1 / -1; text-align: center;">No se encontraron posts con el tag <strong>gobierno</strong>.</p>
            {{/get}}
        </div>
        <div style="text-align: right; margin-top: 15px;">
            <a href="{{@site.url}}/tag/gobierno/" style="color: var(--ghost-accent-color); font-weight: bold; text-decoration: none;">ver más...</a>
        </div>
    </div>
</section>