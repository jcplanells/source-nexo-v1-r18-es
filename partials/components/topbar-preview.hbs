<style>
    /* order:-1 la saca antes del <header> dentro de .gh-viewport (flex-column), sin tocar el layout compartido */
    .topbar-preview {
        order: -1;
        background: var(--background-color, #fff);
        border-bottom: 1px solid var(--color-border, #e5e7eb);
    }
    /* Barra de sitios: con overflow-x el margin:auto del hijo la centra sin cortar el inicio cuando no cabe */
    .topbar-preview-inner {
        display: flex;
        padding: 8px max(4vmin, 20px);
        overflow-x: auto;
        scrollbar-width: none;
    }
    .topbar-preview-inner::-webkit-scrollbar {
        display: none;
    }
    .topbar-preview-links {
        display: flex;
        align-items: center;
        gap: 14px;
        margin: 0 auto;
    }
    .topbar-preview-link {
        display: inline-flex;
        align-items: center;
        padding: 3px 10px;
        border-radius: 999px;
        font-size: 1.2rem;
        font-weight: 700;
        letter-spacing: 0.03em;
        text-transform: uppercase;
        color: var(--color-base, #000);
        text-decoration: none;
        white-space: nowrap;
    }
    .topbar-preview-link:hover {
        color: var(--ghost-accent-color);
    }
    /* Sitio en el que está el lector */
    .topbar-preview-link.is-current,
    .topbar-preview-link.is-current:hover {
        background: #000;
        color: #fff;
    }
    .topbar-preview-divider {
        width: 1px;
        height: 14px;
        background: var(--color-border, #d1d5db);
        flex-shrink: 0;
    }

    /* Variante verde (la que usan home y post) */
    .topbar-preview.topbar-preview-green {
        background: var(--ghost-accent-color, #34cc03);
        border-bottom: none;
    }
    .topbar-preview-green .topbar-preview-inner {
        padding: 7px max(4vmin, 20px);
    }
    .topbar-preview-green .topbar-preview-link {
        color: #fff;
    }
    .topbar-preview-green .topbar-preview-link:hover {
        color: rgba(255, 255, 255, 0.8);
    }
    .topbar-preview-green .topbar-preview-link.is-current,
    .topbar-preview-green .topbar-preview-link.is-current:hover {
        color: #fff;
    }
    .topbar-preview-green .topbar-preview-divider {
        background: #fff;
    }
    @media (max-width: 767px) {
        .topbar-preview-inner {
            padding: 6px 12px;
        }
        .topbar-preview-links {
            gap: 6px;
        }
        .topbar-preview-link {
            padding: 3px 7px;
            font-size: 1rem;
            letter-spacing: 0.01em;
        }
        .topbar-preview-divider {
            height: 12px;
        }
    }
</style>

{{!-- active: nexo | careers | living | sports | trade | licita; por defecto nexo --}}
