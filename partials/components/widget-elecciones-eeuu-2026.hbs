<!-- Nexo · Widget en vivo de las elecciones de EE. UU. 2026 (Senado, Cámara, Gobernadores) · tarjeta HTML de Ghost o partial del tema -->
<div id="nxeu-2026" class="nxeu">
<style>
#nxeu-2026{min-width:0;width:100%;--off:#F1F2E9;--white:#fff;--ink:#020202;--deep:#122805;--g600:#6C6F65;--g100:#E2E4DA;--gold:#DDD197;--green:#34CC03;
  --d:#1F5FD6;--d-l:rgba(31,95,214,.30);--d-t:#1F5FD6;--r:#D62631;--r-l:rgba(214,38,49,.30);--r-t:#C21F2A;--i:#9CF469;--i-l:rgba(156,244,105,.45);
  --wait:#DCDED3;--none:#F1F2EC;
  font-family:"Host Grotesk",system-ui,-apple-system,"Segoe UI",sans-serif;color:var(--ink);background:var(--off);color-scheme:light;
  border-radius:22px;overflow:hidden;margin:0 auto;box-sizing:border-box;max-width:1240px;text-align:left}
#nxeu-2026 *{box-sizing:border-box}
#nxeu-2026 .nx-head{padding:18px clamp(14px,3vw,24px) 6px;display:flex;flex-wrap:wrap;gap:6px 14px;align-items:flex-end;justify-content:space-between}
#nxeu-2026 .nx-tags{display:flex;gap:10px;align-items:center;font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--deep)}
#nxeu-2026 .nx-live{display:inline-flex;align-items:center;gap:6px;background:var(--ink);color:var(--off);padding:4px 9px;border-radius:6px}
#nxeu-2026 .nx-live i{width:8px;height:8px;border-radius:50%;background:#888}
#nxeu-2026 .nx-live.on i{background:var(--green);animation:nxeup 1.4s infinite}
@keyframes nxeup{0%,100%{opacity:1}50%{opacity:.25}}
#nxeu-2026 h3{font-family:inherit;font-size:clamp(20px,3.4vw,28px);line-height:1.1;letter-spacing:-.02em;margin:8px 0 2px;font-weight:800;color:var(--ink)}
#nxeu-2026 .nx-sub{font-size:13px;color:var(--g600)}
#nxeu-2026 .nx-grid{display:grid;grid-template-columns:minmax(0,1fr);gap:12px;padding:10px clamp(10px,2.5vw,20px)}
@media (min-width:900px){#nxeu-2026 .nx-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
#nxeu-2026 .nx-card{background:var(--white);border-radius:14px;box-shadow:0 2px 6px rgba(2,2,2,.08);padding:14px 14px 10px;min-width:0;position:relative}
#nxeu-2026 .nx-eb{font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#207F02}
#nxeu-2026 .nx-cnt{display:grid;grid-template-columns:auto 1fr auto;align-items:end;gap:10px;margin-top:6px}
#nxeu-2026 .nx-n{font-size:clamp(34px,4.6vw,46px);font-weight:800;letter-spacing:-.03em;line-height:.95;font-variant-numeric:tabular-nums}
#nxeu-2026 .nx-n.d{color:var(--d-t)} #nxeu-2026 .nx-n.r{color:var(--r-t);text-align:right}
#nxeu-2026 .nx-pl{font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--g600)}
#nxeu-2026 .nx-mid{text-align:center;font-size:12px;color:var(--g600);line-height:1.25;padding-bottom:4px}
#nxeu-2026 .nx-mid b{display:block;color:var(--ink);font-size:13px}
#nxeu-2026 .nx-bar{position:relative;display:flex;height:12px;border-radius:6px;overflow:hidden;background:var(--wait);margin:8px 0 2px}
#nxeu-2026 .nx-bar span{height:100%;transition:width .35s cubic-bezier(.22,1,.36,1)}
#nxeu-2026 .nx-bar .mk{position:absolute;top:-2px;bottom:-2px;width:2px;background:var(--ink)}
#nxeu-2026 .nx-map{position:relative;margin-top:8px}
#nxeu-2026 .nx-map svg{width:100%;height:auto;display:block}
#nxeu-2026 .nx-map path.st{stroke:#fff;stroke-width:.9;transition:fill .5s;cursor:pointer}
#nxeu-2026 .nx-map path.st:hover{stroke:var(--ink);stroke-width:1.6}
#nxeu-2026 .nx-foot{font-size:12px;color:var(--g600);margin-top:4px;min-height:1.2em}
#nxeu-2026 .nx-tip{position:absolute;z-index:5;visibility:hidden;pointer-events:none;background:rgba(2,2,2,.88);color:var(--off);border:1px solid rgba(52,204,3,.3);border-radius:8px;padding:9px 32px 9px 12px;font-size:12px;line-height:1.45;max-width:220px}
#nxeu-2026 .nx-tip button{position:absolute;top:3px;right:3px;width:26px;height:26px;border:0;border-radius:6px;background:transparent;color:var(--off);font-weight:400;font-size:18px;line-height:26px;font-family:inherit;cursor:pointer;pointer-events:auto;padding:0}
#nxeu-2026 .nx-tip b{display:block;font-size:13px}
#nxeu-2026 .nx-leg{display:flex;flex-wrap:wrap;gap:6px 14px;padding:4px clamp(14px,3vw,24px) 0;font-size:12px;color:var(--g600)}
#nxeu-2026 .nx-leg i{display:inline-block;width:12px;height:12px;border-radius:2px;margin-right:5px;vertical-align:-2px}
#nxeu-2026 .nx-src{padding:10px clamp(14px,3vw,24px) 16px;font-size:12px;color:var(--g600)}
#nxeu-2026 .nx-src a{color:#3366FF}
#nxeu-2026 button:focus-visible,#nxeu-2026 path.st:focus-visible{outline:3px solid #3366FF;outline-offset:2px}
#nxeu-2026 .nx-compact{display:flex;align-items:center;justify-content:space-between;gap:10px 14px;flex-wrap:wrap;padding:8px clamp(14px,3vw,24px) 16px}
#nxeu-2026 .nx-cscore{font-size:13px;font-weight:700;color:var(--ink);font-variant-numeric:tabular-nums}
#nxeu-2026 .nx-cscore span{color:var(--g600);font-weight:400;margin:0 6px}
#nxeu-2026 .nx-toggle{display:inline-flex;align-items:center;gap:6px;background:var(--ink);color:var(--off);border:0;border-radius:8px;padding:8px 14px;font-weight:700;font-size:12px;line-height:1;font-family:inherit;letter-spacing:.02em;cursor:pointer;white-space:nowrap}
#nxeu-2026 .nx-toggle:hover{background:var(--deep)}
#nxeu-2026 .nx-toggle b{display:inline-block;transition:transform .2s;font-weight:400}
#nxeu-2026 .nx-toggle[aria-expanded="true"] b{transform:rotate(180deg)}
#nxeu-2026 .nx-tabs{display:none}
#nxeu-2026[data-tabs] .nx-tabs{display:flex;gap:6px;padding:10px clamp(10px,2.5vw,20px) 0;flex-wrap:wrap}
#nxeu-2026 .nx-tab{border:0;background:var(--white);color:var(--ink);border-radius:8px;padding:9px 14px;font-weight:700;font-size:13px;line-height:1;font-family:inherit;cursor:pointer;box-shadow:0 1px 3px rgba(2,2,2,.08)}
#nxeu-2026 .nx-tab[aria-selected="true"]{background:var(--ink);color:var(--off)}
#nxeu-2026[data-tabs] .nx-grid{grid-template-columns:minmax(0,1fr)}
#nxeu-2026[data-tabs] .nx-card{display:none}
#nxeu-2026[data-tabs] .nx-card.on{display:block}
@media (min-width:900px){#nxeu-2026[data-tabs] .nx-card.on .nx-map{max-width:760px;margin-left:auto;margin-right:auto}}
#nxeu-2026 .nx-detail[hidden]{display:none}
@media (prefers-reduced-motion:reduce){#nxeu-2026 .nx-live.on i{animation:none}#nxeu-2026 .nx-bar span,#nxeu-2026 .nx-map path.st,#nxeu-2026 .nx-toggle b{transition:none}}
</style>
  <div class="nx-head">
    <div>
      <div class="nx-tags"><span class="nx-live" id="nxeu-live"><i></i><span id="nxeu-lt">Antes del cierre</span></span><span>EE. UU. · 3 de noviembre</span></div>
      <h3>Quién gana el Senado, la Cámara y las gobernaciones.</h3>
