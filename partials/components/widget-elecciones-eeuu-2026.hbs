  </div>
  <div class="nx-compact" id="nxeu-compact">
    <div class="nx-cscore" id="nxeu-cscore">Senado 0–0<span>·</span>Cámara 0–0<span>·</span>Gobernadores 0–0</div>
    <button type="button" class="nx-toggle" id="nxeu-toggle" aria-expanded="false" aria-controls="nxeu-detail"><span class="nx-toggle-txt">Ver mapa completo</span><b aria-hidden="true">▾</b></button>
  </div>
  <div class="nx-detail" id="nxeu-detail" hidden>
  <div class="nx-tabs" role="tablist" aria-label="Elección"><button type="button" class="nx-tab" role="tab" data-t="senado" aria-selected="true">Senado</button><button type="button" class="nx-tab" role="tab" data-t="camara" aria-selected="false">Cámara</button><button type="button" class="nx-tab" role="tab" data-t="gob" aria-selected="false">Gobernadores</button></div>
  <div class="nx-grid">
    <div class="nx-card" data-k="senado"></div>
    <div class="nx-card" data-k="camara"></div>
    <div class="nx-card" data-k="gob"></div>
