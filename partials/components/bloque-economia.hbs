<style>
    .bloque-economia {
        margin-top: 20px;
        padding-top: 20px;
        padding-bottom: 20px;
    }
    .bloque-economia .gh-container-title {
        margin-bottom: 30px;
        color: var(--color-base, #000);
        border-bottom: none;
    }
    .grid-bloque-economia {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr;
        gap: 32px;
        align-items: start;
    }
    /* Col 1: noticia destacada grande */
    .economia-card-featured img {
        width: 100%;
        aspect-ratio: 16/9;
        object-fit: cover;
        border-radius: 3px;
        margin-bottom: 14px;
    }
    .economia-card-featured h3 {
        font-size: clamp(2rem, 1.4vw + 1.4rem, 3.2rem);
        font-weight: 700;
        line-height: 1.15;
        letter-spacing: -0.02em;
        margin: 0;
    }
    .economia-card-featured h3 a {
        color: var(--color-base, #000);
        text-decoration: none;
    }
    .economia-card-featured .card-excerpt {
        margin: 10px 0 0;
        font-size: 1.5rem;
        line-height: 1.5;
        color: var(--color-secondary-text, #555);
    }
    .economia-card-featured .card-reading,
    .economia-card-mid .card-reading {
        margin: 6px 0 0;
        font-size: 1.2rem;
        color: var(--color-secondary-text, #757575);
    }
    /* Col 2: 2 notas medianas */
    .economia-posts-mid {
        display: flex;
        flex-direction: column;
        gap: 24px;
        padding-left: 32px;
        border-left: 1px solid var(--color-border, #e5e7eb);
    }
    .economia-card-mid img {
        width: 100%;
        aspect-ratio: 16/9;
        object-fit: cover;
        border-radius: 3px;
        margin-bottom: 10px;
    }
    .economia-card-mid h3 {
        font-size: 1.8rem;
        line-height: 1.2;
        margin: 0;
    }
    .economia-card-mid h3 a {
        color: var(--color-base, #000);
        text-decoration: none;
    }
    /* Col 3: widget ILC */
    .economia-sidebar {
        padding-left: 32px;
        border-left: 1px solid var(--color-border, #e5e7eb);
    }
    @media (max-width: 991px) {
        .grid-bloque-economia {
            grid-template-columns: 1fr 1fr;
        }
        .economia-sidebar {
            grid-column: 1 / -1;
            padding-left: 0;
            border-left: none;
            border-top: 1px solid var(--color-border, #e5e7eb);
            padding-top: 24px;
        }
    }
    @media (max-width: 767px) {
        .grid-bloque-economia {
            grid-template-columns: 1fr;
        }
        .economia-posts-mid {
            padding-left: 0;
            border-left: none;
        }
        .economia-card-mid {
            display: flex;
            flex-direction: row;
            gap: 12px;
            align-items: flex-start;
        }
        .economia-card-mid > a {
            flex-shrink: 0;
            width: 110px;
        }
        .economia-card-mid img {
            width: 100%;
            aspect-ratio: 16/9;
            margin-bottom: 0;
        }
        .economia-card-mid .economia-mid-text {
            flex: 1;
            min-width: 0;
        }
    }
</style>

<section class="gh-outer bloque-economia">
    <div class="gh-inner">
        <h2 class="gh-container-title">
            <span style="border-bottom: 3px solid var(--ghost-accent-color); padding-bottom: 9px;">
                <a href="https://nexo.la/tag/economia/" style="text-decoration: none; color: inherit;">Economía y Finanzas</a>
            </span>
        </h2>

        <div class="grid-bloque-economia">

            {{#get "posts" filter="primary_tag:[economia,finanzas]+tag:-[hash-top1,hash-top2,hash-top3]+featured:false" limit="3" include="authors"}}
                {{!-- Col 1: noticia grande --}}
                {{#foreach posts}}
                    {{#if @first}}
                        <article class="economia-card-featured">
                            {{#if feature_image}}
                                <a href="{{url}}">
                                    <img src="{{feature_image}}" alt="{{title}}">
                                </a>
                            {{/if}}
                            <h3><a href="{{url}}">{{title}}</a></h3>
                            {{#if custom_excerpt}}
                                <p class="card-excerpt">{{custom_excerpt}}</p>
                            {{else}}
                                {{#if excerpt}}<p class="card-excerpt">{{excerpt}}</p>{{/if}}
                            {{/if}}
                            <p class="card-reading">{{reading_time minute="1 min de lectura" minutes="% min de lectura"}}</p>
                        </article>
                    {{/if}}
                {{/foreach}}

                {{!-- Col 2: notas 2 y 3 --}}
                <div class="economia-posts-mid">
                    {{#foreach posts}}
                        {{#unless @first}}
                            <article class="economia-card-mid">
                                {{#if feature_image}}
                                    <a href="{{url}}">
                                        <img src="{{feature_image}}" alt="{{title}}">
                                    </a>
                                {{/if}}
                                <div class="economia-mid-text">
                                    <h3><a href="{{url}}">{{title}}</a></h3>
                                    <p class="card-reading">{{reading_time minute="1 min de lectura" minutes="% min de lectura"}}</p>
                                </div>
                            </article>
                        {{/unless}}
                    {{/foreach}}
                </div>
            {{/get}}

            {{!-- Col 3: widget ILC (Predictor del PIB) --}}
            <div class="economia-sidebar">
                {{> "components/widget-pib-preview"}}
            </div>

        </div>

        <div style="text-align: right; margin-top: 15px;">
            <a href="https://nexo.la/tag/economia/" style="color: var(--ghost-accent-color); font-weight: bold; text-decoration: none;">ver más...</a>
        </div>
    </div>
</section>
