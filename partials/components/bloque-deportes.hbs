<style>
    .bloque-deportes {
        padding-top: 20px;
        padding-bottom: 20px;
        margin-top: 20px;
    }
    .bloque-deportes .gh-container-title {
        margin-bottom: 30px;
        color: var(--color-base, #000);
        border-bottom: none;
    }
    /* Portada del bloque: 1 nota grande + 2 columnas con 2 notas cada una */
    .grid-bloque-deportes {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr;
        grid-template-rows: auto auto;
        gap: 32px;
    }
    .grid-bloque-deportes > * {
        min-width: 0;
    }
    .card-bloque-deportes:first-child {
        grid-row: span 2;
    }
    .card-bloque-deportes:first-child h3 {
        font-size: clamp(2.4rem, 1vw + 2rem, 3.2rem);
    }
    @media (max-width: 991px) {
        .grid-bloque-deportes {
            grid-template-columns: 1fr 1fr;
            grid-template-rows: auto;
        }
        .card-bloque-deportes:first-child {
            grid-column: span 2;
            grid-row: span 1;
        }
        .card-bloque-deportes:first-child h3 {
            font-size: 1.8rem;
        }
    }
    @media (max-width: 767px) {
        .grid-bloque-deportes {
            grid-template-columns: 1fr;
        }
        .card-bloque-deportes:first-child {
            grid-column: span 1;
        }
        .card-bloque-deportes.is-nota {
            display: flex;
            flex-direction: row;
            gap: 12px;
            align-items: flex-start;
        }
        .card-bloque-deportes.is-nota > a {
            flex-shrink: 0;
            width: 110px;
        }
        .card-bloque-deportes.is-nota img {
            width: 100%;
            aspect-ratio: 16/9;
            margin-bottom: 0;
        }
        .card-bloque-deportes.is-nota .deportes-text {
            flex: 1;
            min-width: 0;
        }
    }
    .card-bloque-deportes img {
        width: 100%;
        aspect-ratio: 16/9;
        object-fit: cover;
        border-radius: 3px;
        margin-bottom: 12px;
    }
    .card-bloque-deportes h3 {
        font-size: 1.8rem;
        line-height: 1.2;
        margin: 0;
    }
    .card-bloque-deportes h3 a {
        color: var(--color-base, #000);
        text-decoration: none;
    }
    .card-bloque-deportes .deportes-meta {
        display: block;
        font-size: 1.2rem;
        color: var(--color-secondary-text, #888);
        margin-top: 6px;
    }
    /* Resumen: solo en la nota principal, como en el bloque de portada */
    .card-bloque-deportes .deportes-excerpt {
        font-size: 1.5rem;
        line-height: 1.45;
        color: var(--color-base, #000);
        margin: 10px 0 0;
        display: -webkit-box;
        -webkit-line-clamp: 4;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    @media (max-width: 767px) {
        .card-bloque-deportes .deportes-excerpt {
            font-size: 1.4rem;
            -webkit-line-clamp: 3;
        }
    }
</style>
<section class="gh-outer bloque-deportes">
    <div class="gh-inner">
        <h2 class="gh-container-title">
            <span style="border-bottom: 3px solid var(--ghost-accent-color); padding-bottom: 9px;">
                <a href="{{@site.url}}/tag/deportes/" style="text-decoration: none; color: inherit;">Deportes</a>
            </span>
        </h2>
        <div class="grid-bloque-deportes">
            {{#get "posts" filter="primary_tag:deportes" limit="5" include="tags,authors"}}
                {{#foreach posts}}
                    <article class="card-bloque-deportes{{#unless @first}} is-nota{{/unless}}">
                        {{#if feature_image}}
                            <a href="{{url}}">
                                <img src="{{feature_image}}" alt="{{title}}">
                            </a>
                        {{/if}}
                        <div class="deportes-text">
                            <h3>
                                <a href="{{url}}">{{title}}</a>
                            </h3>
                            {{#if @first}}
                                {{#if custom_excerpt}}
                                    <p class="deportes-excerpt">{{custom_excerpt}}</p>
                                {{else}}
                                    <p class="deportes-excerpt">{{excerpt characters="260"}}</p>
                                {{/if}}
                            {{/if}}
                            <span class="deportes-meta">{{reading_time minute="1 min de lectura" minutes="% min de lectura"}}</span>
                        </div>
                    </article>
                {{/foreach}}
            {{else}}
                <p style="grid-column: 1 / -1; text-align: center;">No se encontraron posts con el tag <strong>deportes</strong>.</p>
            {{/get}}
        </div>
        <div style="text-align: right; margin-top: 15px;">
            <a href="{{@site.url}}/tag/deportes/" style="color: var(--ghost-accent-color); font-weight: bold; text-decoration: none;">ver más...</a>
        </div>
    </div>
</section>
