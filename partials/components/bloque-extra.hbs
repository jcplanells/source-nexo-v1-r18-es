<style>
    .bloque-extra {
        margin-top: 20px;
        margin-bottom: 40px;
    }
    .bloque-extra .gh-container-title {
        margin-bottom: 30px;
        color: var(--color-base, #000);
        border-bottom: none;
    }
    .grid-bloque-extra {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 32px;
    }
    @media (max-width: 991px) {
        .grid-bloque-extra {
            grid-template-columns: repeat(2, 1fr);
        }
    }
    @media (max-width: 767px) {
        .grid-bloque-extra {
            grid-template-columns: 1fr;
        }
    }
    .card-bloque-extra img {
        width: 100%;
        aspect-ratio: 16/9;
        object-fit: cover;
        border-radius: 3px;
        margin-bottom: 12px;
    }
    .card-bloque-extra h3 {
        font-size: 1.8rem;
        line-height: 1.2;
        margin: 0;
    }
    .card-bloque-extra h3 a {
        color: var(--color-base, #000);
        text-decoration: none;
    }
</style>
<section class="gh-outer bloque-extra">
    <div class="gh-inner">
            <h2 class="gh-container-title">
                <span style="border-bottom: 3px solid var(--ghost-accent-color); padding-bottom: 9px;">
                    Destacados
                </span>
            </h2>
            <div class="grid-bloque-extra">
                {{!-- Se revisa si el tag del bloque 0 existe para no crear un filtro inválido --}}
                {{#if @custom.bloque_0_tag}}
                    {{#get "posts" filter=(concat "featured:true+tag:-[" @custom.bloque_0_tag ",empresas,graficas,tecnologia,emprendimiento,logistica,turismo,gobierno]") limit="8" include="authors"}}
                        {{#foreach posts from="5"}}
                            <article class="card-bloque-extra">
                                {{#if feature_image}}
                                    <a href="{{url}}"><img src="{{feature_image}}" alt="{{title}}"></a>
                                {{/if}}
                                <h3><a href="{{url}}">{{title}}</a></h3>
                            </article>
                        {{else}}
                            <p style="grid-column: 1 / -1; text-align: center;">No hay posts destacados adicionales para mostrar.</p>
                        {{/foreach}}
                    {{/get}}
                {{else}}
                    {{#get "posts" filter="featured:true+tag:-[empresas,graficas,tecnologia,emprendimiento,logistica,turismo,gobierno]" limit="8" include="authors"}}
                        {{#foreach posts from="5"}}
                            <article class="card-bloque-extra">
                                {{#if feature_image}}
                                    <a href="{{url}}"><img src="{{feature_image}}" alt="{{title}}"></a>
                                {{/if}}
                                <h3><a href="{{url}}">{{title}}</a></h3>
                            </article>
                        {{else}}
                            <p style="grid-column: 1 / -1; text-align: center;">No hay posts destacados adicionales para mostrar.</p>
                        {{/foreach}}
                    {{/get}}
                {{/if}}
            </div>
    </div>
</section>