<style>
    .bloque-extra {
        margin-top: 20px;
        margin-bottom: 40px;
    }
    .bloque-extra .gh-container-title {
        margin-bottom: 30px;
        color: var(--color-base, #000);
        border-bottom: none;
    }
    .grid-bloque-extra {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 32px;
    }
    @media (max-width: 991px) {
        .grid-bloque-extra {
            grid-template-columns: repeat(2, 1fr);
        }
    }
    @media (max-width: 767px) {
        .grid-bloque-extra {
            grid-template-columns: 1fr;
        }
    }
    .card-bloque-extra img {
        width: 100%;
        aspect-ratio: 16/9;
        object-fit: cover;
        border-radius: 3px;
        margin-bottom: 12px;
    }
    .card-bloque-extra h3 {
        font-size: 1.8rem;
        line-height: 1.2;
        margin: 0;
    }
    .card-bloque-extra h3 a {
        color: var(--color-base, #000);
        text-decoration: none;
    }
</style>
<section class="gh-outer bloque-extra">
    <div class="gh-inner">
            <h2 class="gh-container-title">
                <span style="border-bottom: 3px solid var(--ghost-accent-color); padding-bottom: 9px;">
                    Destacados
                </span>
            </h2>
            <div class="grid-bloque-extra">
                {{!-- Muestra posts "featured" que NO tengan los tags de los otros bloques --}}
                {{#get "posts" filter=(concat "featured:true+tag:-[" @custom.bloque_0_tag ",graficas,tecnologia,emprendimiento,logistica,turismo]") limit="8" include="authors"}}
                    {{#foreach posts from="5"}}
                        <article class="card-bloque-extra">
                            {{#if feature_image}}
                                <a href="{{url}}">
                                    <img src="{{feature_image}}" alt="{{title}}">
                                </a>
                            {{/if}}
                            <h3>
                                <a href="{{url}}">{{title}}</a>
                            </h3>
                        </article>
                    {{/foreach}}
                {{/get}}
            </div>
    </div>
</section>