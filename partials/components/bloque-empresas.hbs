<style>
    .bloque-empresas {
        padding-top: 20px;
        padding-bottom: 20px;
        margin-top: 20px;
    }
    .bloque-empresas .gh-container-title {
        margin-bottom: 30px;
        color: var(--color-base, #000);
        border-bottom: none;
    }
    .grid-bloque-empresas {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 32px;
    }
    @media (max-width: 991px) {
        .grid-bloque-empresas {
            grid-template-columns: repeat(2, 1fr);
        }
    }
    @media (max-width: 767px) {
        .grid-bloque-empresas {
            grid-template-columns: 1fr;
        }
        .card-bloque-empresas.is-nota {
            display: flex;
            flex-direction: row;
            gap: 12px;
            align-items: flex-start;
        }
        .card-bloque-empresas.is-nota > a {
            flex-shrink: 0;
            width: 110px;
        }
        .card-bloque-empresas.is-nota img {
            width: 100%;
            aspect-ratio: 16/9;
            margin-bottom: 0;
        }
        .card-bloque-empresas.is-nota .empresas-text {
            flex: 1;
            min-width: 0;
        }
    }

    .card-bloque-empresas img {
        width: 100%;
        aspect-ratio: 16/9;
        object-fit: cover;
        border-radius: 3px;
        margin-bottom: 12px;
    }
    .card-bloque-empresas h3 {
        font-size: 1.8rem;
        line-height: 1.2;
        margin: 0;
    }
    .card-bloque-empresas h3 a {
        color: var(--color-base, #000);
        text-decoration: none;
    }
    .card-bloque-empresas .empresas-meta {
        display: block;
        font-size: 1.2rem;
        color: var(--color-secondary-text, #888);
        margin-top: 6px;
    }
</style>
<section class="gh-outer bloque-empresas">
    <div class="gh-inner">
        <h2 class="gh-container-title">
            <span style="border-bottom: 3px solid var(--ghost-accent-color); padding-bottom: 9px;">
                <a href="{{@site.url}}/tag/empresas/" style="text-decoration: none; color: inherit;">Empresas</a>
            </span>
        </h2>
        <div class="grid-bloque-empresas">
            {{!-- La primera nota del bloque (hero) nunca puede ser featured; las otras dos sí. --}}
            {{#get "posts" filter="primary_tag:empresas+featured:false" limit="1" include="tags,authors" as |empresasHero|}}
                {{#foreach empresasHero}}
                    {{> "components/card-empresa" esNota=false}}
                {{/foreach}}
                {{#get "posts" filter=(concat "primary_tag:empresas+id:-" empresasHero.[0].id) limit="2" include="tags,authors"}}
                    {{#foreach posts}}
                        {{> "components/card-empresa" esNota=true}}
                    {{/foreach}}
                {{/get}}
            {{else}}
                {{!-- Sin notas no-featured: se muestran las 3 más recientes con tag empresas. --}}
                {{#get "posts" filter="primary_tag:empresas" limit="3" include="tags,authors"}}
                    {{#foreach posts}}
                        {{#if @first}}
                            {{> "components/card-empresa" esNota=false}}
                        {{else}}
                            {{> "components/card-empresa" esNota=true}}
                        {{/if}}
                    {{else}}
                        <p style="grid-column: 1 / -1; text-align: center;">No se encontraron posts con el tag <strong>empresas</strong>.</p>
                    {{/foreach}}
                {{/get}}
            {{/get}}
        </div>
        <div style="text-align: right; margin-top: 15px;">
            <a href="{{@site.url}}/tag/empresas/" style="color: var(--ghost-accent-color); font-weight: bold; text-decoration: none;">ver más...</a>
        </div>
    </div>
</section>