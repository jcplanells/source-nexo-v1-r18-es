{{#get "posts" include="authors" limit=limit as |posts|}}
    <section class="gh-featured gh-outer">
        <div class="gh-featured-inner gh-inner">
            <h2 class="gh-featured-title"><span style="border-bottom: 3px solid var(--ghost-accent-color); padding-bottom: 8px;">Las Últimas</span></h2>
            <div class="gh-featured-feed">
                {{#foreach posts}}
                    <article class="gh-card {{post_class}}">
                        <a class="gh-card-link" href="{{url}}?utm_source=nexo&utm_medium=home&utm_campaign=las_ultimas&utm_content=las_ultimas">
                            {{#if feature_image}}
                                <img class="gh-card-image" src="{{img_url feature_image size="xs"}}" alt="{{title}}">
                            {{/if}}
                            <div class="gh-card-wrapper">
                                <h3 class="gh-card-title"><span class="post-time">{{date published_at format="h:mm a"}}</span> - {{title}}</h3>
                            </div>
                        </a>
                    </article>
                {{/foreach}}
            </div>
        </div>
    </section>
{{/get}}
