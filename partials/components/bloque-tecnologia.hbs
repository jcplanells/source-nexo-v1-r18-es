<style>
    .bloque-tecnologia {
        padding-top: 0;
        padding-bottom: 10px;
        margin-top: 0;
    }
    .bloque-tecnologia .gh-container-title {
        margin-bottom: 30px;
        color: var(--color-base, #000);
        border-bottom: none;
    }
    .grid-bloque-tecnologia {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 32px;
    }
    @media (max-width: 991px) {
        .grid-bloque-tecnologia {
            grid-template-columns: repeat(2, 1fr);
        }
    }
    @media (max-width: 767px) {
        .grid-bloque-tecnologia {
            grid-template-columns: 1fr;
        }
        .card-bloque-tecnologia.is-nota {
            display: flex;
            flex-direction: row;
            gap: 12px;
            align-items: flex-start;
        }
        .card-bloque-tecnologia.is-nota > a {
            flex-shrink: 0;
            width: 110px;
        }
        .card-bloque-tecnologia.is-nota img {
            width: 100%;
            aspect-ratio: 16/9;
            margin-bottom: 0;
        }
        .card-bloque-tecnologia.is-nota .tecnologia-text {
            flex: 1;
            min-width: 0;
        }
    }
    .card-bloque-tecnologia img {
        width: 100%;
        aspect-ratio: 16/9;
        object-fit: cover;
        border-radius: 3px;
        margin-bottom: 12px;
    }
    .card-bloque-tecnologia h3 {
        font-size: 1.8rem;
        line-height: 1.2;
        margin: 0;
    }
    .card-bloque-tecnologia h3 a {
        color: var(--color-base, #000);
        text-decoration: none;
    }
    .card-bloque-tecnologia .tecnologia-meta {
        display: block;
        font-size: 1.2rem;
        color: var(--color-secondary-text, #888);
        margin-top: 6px;
    }
</style>
<section class="gh-outer bloque-tecnologia">
    <div class="gh-inner">
            <h2 class="gh-container-title">
                <span style="border-bottom: 3px solid var(--ghost-accent-color); padding-bottom: 9px;">
                    <a href="https://nexo.la/tag/tecnologia/" style="text-decoration: none; color: inherit;">Tecnología</a>
                </span>
            </h2>
            <div class="grid-bloque-tecnologia">
                {{#get "posts" filter="primary_tag:tecnologia" limit="4" include="authors"}}
                    {{#foreach posts}}
                        <article class="card-bloque-tecnologia{{#unless @first}} is-nota{{/unless}}">
                            {{#if feature_image}}
                                <a href="{{url}}">
                                    <img src="{{feature_image}}" alt="{{title}}">
                                </a>
                            {{/if}}
                            <div class="tecnologia-text">
                                <h3>
                                    <a href="{{url}}">{{title}}</a>
                                </h3>
                                <span class="tecnologia-meta">{{reading_time minute="1 min de lectura" minutes="% min de lectura"}}</span>
                            </div>
                        </article>
                    {{/foreach}}
                {{/get}}
            </div>
            <div style="text-align: right; margin-top: 15px;">
                <a href="https://nexo.la/tag/tecnologia/" style="color: var(--ghost-accent-color); font-weight: bold; text-decoration: none;">ver más...</a>
            </div>
    </div>
</section>