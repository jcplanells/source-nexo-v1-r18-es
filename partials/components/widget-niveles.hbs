<style>
  .widget-niveles {
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "SF Pro Text", sans-serif;
    width: 100%;
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    box-sizing: border-box;
  }
  .widget-niveles-card {
    background: #ffffff;
    border-radius: 24px;
    border: 1px solid #e5e7eb;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.05);
    padding: 24px;
    width: 100%;
    max-width: 480px;
    box-sizing: border-box;
  }
  .widget-niveles .titulo-principal { text-align: center; margin-bottom: 15px; }
  .widget-niveles .titulo-principal h1 { margin: 0 0 5px; font-size: 1.7rem; color: #111827; font-weight: 600; line-height: 1.3; }
  .widget-niveles #fecha { font-size: 1.1rem; color: #6b7280; text-align: center; }
  .widget-niveles .contenedor-lagos { display: flex; justify-content: center; gap: 20px; flex-wrap: wrap; margin-top: 20px; }
  .widget-niveles .lake-column { display: flex; flex-direction: column; align-items: center; }
  .widget-niveles .lake-title { margin-bottom: 12px; font-size: 1.2rem; font-weight: 600; text-align: center; margin-top: 0; color: #374151; }
  .widget-niveles .tank-wrapper { display: flex; align-items: flex-end; gap: 5px; position: relative; }
  .widget-niveles .scale-labels { position: relative; height: 240px; width: 30px; }
  .widget-niveles .scale-label { position: absolute; left: 0; transform: translateY(50%); font-size: 1.05rem; color: #6b7280; line-height: 1; }
  .widget-niveles .color-bar { width: 10px; height: 240px; display: flex; flex-direction: column; border-radius: 4px; overflow: hidden; box-shadow: inset 0 0 0 1px #e5e7eb; }
  .widget-niveles .color-bar div { flex-shrink: 0; }
  .widget-niveles .bar-red { background: #ef4444; } 
  .widget-niveles .bar-yellow { background: #facc15; } 
  .widget-niveles .bar-green { background: #22c55e; }
  .widget-niveles .tank-container { position: relative; width: 100px; height: 240px; border: 2px solid #d1d5db; border-radius: 8px; overflow: hidden; background: #f9fafb; box-shadow: inset 0 0 10px rgba(0,0,0,0.05); }
  .widget-niveles .water { position: absolute; bottom: 0; width: 100%; height: 0%; background: rgba(34, 197, 94, 0.6); border-top: 2px solid #22c55e; transition: height 2s ease; }
  .widget-niveles .level-line { position: absolute; left: 0; width: 100%; height: 1px; border-top: 1px dashed #9ca3af; }
  .widget-niveles .label { position: absolute; left: 100%; margin-left: 8px; color: #4b5563; font-size: 1.05rem; white-space: nowrap; }
  .widget-niveles .label-actual { color: #d97706; font-weight: bold; }
  .widget-niveles .level-tag { position: absolute; left: 50%; transform: translate(-50%, 50%); background: rgba(255, 255, 255, 0.9); border: 1px solid #e5e7eb; color: #111827; font-size: 1.0rem; padding: 2px 4px; border-radius: 3px; white-space: nowrap; z-index: 3; box-shadow: 0 1px 2px rgba(0,0,0,0.05); }
  .widget-niveles .spinner { display: inline-block; width: 14px; height: 14px; border: 2px solid rgba(0,0,0,0.1); border-left-color: #555; border-radius: 50%; animation: spin-widget 1s linear infinite; vertical-align: middle; margin-right: 8px; }
  @keyframes spin-widget { to { transform: rotate(360deg); } }
</style>

<div class="widget-niveles">
  <div class="widget-niveles-card">
  <div class="titulo-principal">
    <h1>Nivel de los principales lagos del Canal de Panamá</h1>
    <div id="fecha"><div class="spinner"></div>Cargando datos...</div>
  </div>

  <div class="contenedor-lagos">
    <!-- LAGO GATÚN -->
    <div class="lake-column">
      <h2 class="lake-title">Nivel del lago Gatún</h2>
      <div class="tank-wrapper">
        <div class="scale-labels">
          <div class="scale-label" style="bottom: 0%;">75</div>
          <div class="scale-label" style="bottom: 25%;">79</div>
          <div class="scale-label" style="bottom: 62.5%;">85</div>
          <div class="scale-label" style="bottom: 81.25%;">88</div>
          <div class="scale-label" style="bottom: 87.5%;">89</div>
          <div class="scale-label" style="bottom: 100%;">91</div>
        </div>
        <div class="color-bar">
          <div class="bar-red" style="flex: 2;"></div>
          <div class="bar-yellow" style="flex: 1;"></div>
          <div class="bar-green" style="flex: 3;"></div>
          <div class="bar-yellow" style="flex: 6;"></div>
          <div class="bar-red" style="flex: 4;"></div>
        </div>
        <div class="tank-container">
          <div id="water-gatun" class="water water-gatun"></div>
          <div id="tag-gatun" class="level-tag" style="bottom: 0%;">-- ft</div>
          <div class="level-line" style="bottom: 87.5%;"><div class="label">Máx: <strong>89'</strong></div></div>
          <div class="level-line" style="bottom: 81.25%;"><div class="label">Esp: <strong>88'</strong></div></div>
          <div id="line-gatun" class="level-line" style="bottom: 0%;"><div id="label-gatun" class="label label-actual">Actual: --</div></div>
        </div>
      </div>
    </div>

    <!-- LAGO ALHAJUELA -->
    <div class="lake-column">
      <h2 class="lake-title">Nivel del lago Alhajuela</h2>
      <div class="tank-wrapper">
        <div class="scale-labels">
          <div class="scale-label" style="bottom: 0%;">190</div>
          <div class="scale-label" style="bottom: 14.3%;">200</div>
          <div class="scale-label" style="bottom: 28.6%;">210</div>
          <div class="scale-label" style="bottom: 85.7%;">250</div>
          <div class="scale-label" style="bottom: 92.9%;">255</div>
          <div class="scale-label" style="bottom: 100%;">260</div>
        </div>
        <div class="color-bar">
          <div class="bar-red" style="flex: 5;"></div>
          <div class="bar-yellow" style="flex: 5;"></div>
          <div class="bar-green" style="flex: 40;"></div>
          <div class="bar-yellow" style="flex: 10;"></div>
          <div class="bar-red" style="flex: 10;"></div>
        </div>
        <div class="tank-container">
          <div id="water-alhajuela" class="water water-alhajuela"></div>
          <div id="tag-alhajuela" class="level-tag" style="bottom: 0%;">-- ft</div>
          <div class="level-line" style="bottom: 92.9%;"><div class="label">Máx: <strong>255'</strong></div></div>
          <div class="level-line" style="bottom: 85.7%;"><div class="label">Esp: <strong>250'</strong></div></div>
          <div id="line-alhajuela" class="level-line" style="bottom: 0%;"><div id="label-alhajuela" class="label label-actual">Actual: --</div></div>
        </div>
      </div>
    </div>
  </div>
  </div>
</div>

<script>
  window.addEventListener("load", async () => {
    // URL de tu API o archivo JSON con los datos actualizados
    // Formato esperado del JSON: { "fecha": "6 de enero de 2026", "gatun": 88.81, "alhajuela": 252.62 }
    
    const DATA_URL = "https://opt.nexo.la/assets/json/niveles.json";

    try {
      const resp = await fetch(DATA_URL);
      if (!resp.ok) throw new Error("HTTP " + resp.status); // Detectar si el archivo no existe (404)
      const data = await resp.json();
      
      // DATOS DE EJEMPLO (Bórralos cuando conectes la URL real)
      // const data = { fecha: "6 de enero de 2026", gatun: 88.81, alhajuela: 252.62 };

      // 1. Actualizar Fecha
      document.getElementById("fecha").textContent = "Dato al " + data.fecha;

      // 2. Función para calcular altura y actualizar visualización
      const updateLake = (id, val, min, max) => {
        // Calcula el porcentaje basado en la escala visual (min y max del gráfico)
        const pct = Math.max(0, Math.min(100, ((val - min) / (max - min)) * 100));
        
        document.getElementById(`water-${id}`).style.height = pct + "%";
        document.getElementById(`tag-${id}`).textContent = val + " ft";
        document.getElementById(`tag-${id}`).style.bottom = pct + "%";
        document.getElementById(`line-${id}`).style.bottom = pct + "%";
        document.getElementById(`label-${id}`).textContent = "Actual: " + val + "'";
      };

      // 3. Ejecutar actualización (Gatún escala: 75-91, Alhajuela escala: 190-260)
      setTimeout(() => updateLake("gatun", data.gatun, 75, 91), 100);
      setTimeout(() => updateLake("alhajuela", data.alhajuela, 190, 260), 100);

    } catch (e) {
      console.error("Error cargando niveles:", e);
      // Muestra el error técnico en pantalla para ayudar a depurar
      document.getElementById("fecha").innerHTML = "<span style='color:#ef4444; font-size:1.1rem'>Error: " + e.message + "</span>";
    }
  });
</script>