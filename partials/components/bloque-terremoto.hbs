<style>
    .bloque-terremoto {
        padding-top: 20px;
        padding-bottom: 20px;
        margin-top: 20px;
    }
    .bloque-terremoto .gh-container-title {
        margin-bottom: 30px;
        color: var(--color-base, #000);
        border-bottom: none;
    }

    .sismo-widget {
        --sw-green: var(--ghost-accent-color, #34cc03);
        --sw-amber: #e8c988;
        --sw-salmon: #F26E5F;
        --sw-blue: #4f8ef7;
        font-family: system-ui, -apple-system, BlinkMacSystemFont, "SF Pro Text", sans-serif;
        max-width: 1040px;
        margin: 0 auto;
        background: #0a0a0a;
        color: #fff;
        border-radius: 24px;
        padding: 24px;
        box-sizing: border-box;
    }
    .sismo-loading, .sismo-error {
        text-align: center;
        padding: 40px 16px;
        color: rgba(255,255,255,0.6);
        font-size: 1.4rem;
    }
    .sismo-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 18px;
    }
    .sismo-live {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 1.2rem;
        font-weight: 700;
        color: var(--sw-salmon);
    }
    .sismo-live-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--sw-salmon);
        animation: sismo-pulse 1.4s ease-in-out infinite;
    }
    @keyframes sismo-pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.3; }
    }
    @media (prefers-reduced-motion: reduce) { .sismo-live-dot { animation: none; } }
    .sismo-updated {
        font-size: 1.1rem;
        color: rgba(255,255,255,0.5);
    }

    .sismo-grid {
        display: grid;
        grid-template-columns: minmax(240px, 1fr) minmax(320px, 1.6fr);
        gap: 20px;
        align-items: start;
    }

    .sismo-total-card {
        background: #151515;
        border-radius: 16px;
        padding: 20px;
        margin-bottom: 16px;
    }
    .sismo-total-value {
        font-size: 3.6rem;
        font-weight: 800;
        line-height: 1;
    }
    .sismo-total-label {
        font-size: 1.3rem;
        color: rgba(255,255,255,0.6);
        margin-top: 4px;
    }
    .sismo-progress {
        display: flex;
        height: 22px;
        border-radius: 6px;
        overflow: hidden;
        margin-top: 16px;
        font-size: 1.1rem;
        font-weight: 700;
    }
    .sismo-progress span {
        display: flex;
        align-items: center;
        justify-content: center;
        color: #0a0a0a;
        min-width: 0;
        overflow: hidden;
    }
    .sismo-legend {
        display: flex;
        flex-wrap: wrap;
        gap: 6px 14px;
        margin-top: 10px;
        font-size: 1.2rem;
        color: rgba(255,255,255,0.75);
    }
    .sismo-legend-dot {
        display: inline-block;
        width: 9px;
        height: 9px;
        border-radius: 50%;
        margin-right: 5px;
    }

    .sismo-stats {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
    }
    .sismo-stat-card {
        background: #151515;
        border-radius: 16px;
        padding: 14px 16px;
    }
    .sismo-stat-label {
        font-size: 1rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: rgba(255,255,255,0.5);
        font-weight: 700;
    }
    .sismo-stat-value {
        font-size: 2.2rem;
        font-weight: 800;
        margin-top: 4px;
    }
    .sismo-stat-sub {
        font-size: 1.05rem;
        color: rgba(255,255,255,0.5);
        margin-top: 2px;
        line-height: 1.35;
    }

    .sismo-charts {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }
    .sismo-chart-card {
        background: #151515;
        border-radius: 16px;
        padding: 16px 18px;
    }
    .sismo-chart-title {
        font-size: 1.3rem;
        font-weight: 700;
    }
    .sismo-chart-sub {
        font-size: 1.05rem;
        color: rgba(255,255,255,0.5);
        margin-top: 2px;
        margin-bottom: 8px;
    }
    .sismo-chart-card svg { display: block; width: 100%; height: auto; }
    .sismo-chart-legend {
        display: flex;
        flex-wrap: wrap;
        gap: 6px 16px;
        margin-top: 6px;
        font-size: 1.05rem;
        color: rgba(255,255,255,0.7);
    }

    .sismo-footer {
        margin-top: 18px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 6px;
        font-size: 1rem;
        color: rgba(255,255,255,0.4);
    }
    .sismo-footer a { color: var(--sw-green); font-weight: 700; text-decoration: none; font-size: 1.15rem; }

    @media (max-width: 767px) {
        .sismo-grid { grid-template-columns: 1fr; }
        .sismo-stats { grid-template-columns: 1fr 1fr; }
        .sismo-total-value { font-size: 3rem; }
    }
</style>

<section class="gh-outer bloque-terremoto">
    <div class="gh-inner">
        <h2 class="gh-container-title">
            <span style="border-bottom: 3px solid var(--ghost-accent-color); padding-bottom: 9px;">
                Terremoto en Panamá
            </span>
        </h2>

        <div class="sismo-widget" id="sismo-widget">
            <div class="sismo-loading">Cargando el listado de sismos…</div>
        </div>

        <div style="text-align: right; margin-top: 15px;">
            <a href="https://pro.nexo.la/terremoto.html" style="color: var(--ghost-accent-color); font-weight: bold; text-decoration: none;">ver más...</a>
        </div>
    </div>
</section>

<script>
(function () {
    var DATA_URL = 'https://opt.nexo.la/assets/json/sismos-azuero.json';
    var root = document.getElementById('sismo-widget');
    if (!root) return;
    var DIAS = ['domingo','lunes','martes','miércoles','jueves','viernes','sábado'];
    var DCORTO = ['Dom','Lun','Mar','Mié','Jue','Vie','Sáb'];
    var MESES = ['enero','febrero','marzo','abril','mayo','junio','julio','agosto','septiembre','octubre','noviembre','diciembre'];

    // Las horas del IGC son de Panamá (UTC-5, sin horario de verano).
    function ts(iso) { return new Date(iso + '-05:00').getTime(); }
    function hora(iso) { var h = +iso.slice(11, 13); return ((h % 12) || 12) + ':' + iso.slice(14, 16) + ' ' + (h < 12 ? 'a.m.' : 'p.m.'); }
    function diaN(f) { return new Date(f + 'T12:00:00-05:00').getUTCDay(); }
    function hoyPa() { return new Date(Date.now() - 5 * 3600e3).toISOString().slice(0, 10); }
    function sumarDia(f) { return new Date(ts(f + 'T12:00:00') + 864e5 - 5 * 3600e3).toISOString().slice(0, 10); }
    function m1(x) { return x.toFixed(1); }
    function donde(e) { return e.dist ? ('a ' + e.dist + ' km al ' + e.rumbo + ' de ' + e.ref) : e.ref; }
    // En pantallas angostas el SVG se dibuja sobre un lienzo de 380 para que la letra no se encoja.
    function angosto() { return root.clientWidth < 560; }
    function maxMag(l) { return l.reduce(function (a, e) { return Math.max(a, e.mag); }, 0); }

    function prep(d) {
        var t0 = ts(d.principal.fecha_hora);
        var ev = d.eventos.map(function (e) {
            return { iso: e[0], f: e[0].slice(0, 10), mag: e[4], rev: e[5], ref: e[6], dist: e[7], rumbo: e[8], zona: e[9], t: ts(e[0]) };
        });
        return { P: d.principal, t0: t0, ult: d.ultimo_sismo, tu: ts(d.ultimo_sismo),
                 rep: ev.filter(function (e) { return e.zona && e.t > t0; }) };
    }

    function porDia(D) {
        var dias = [], f = D.P.fecha_hora.slice(0, 10), fin = hoyPa();
        if (D.ult.slice(0, 10) > fin) fin = D.ult.slice(0, 10);
        while (f <= fin) {
            var del = D.rep.filter(function (e) { return e.f === f; });
            dias.push({ f: f, total: del.length, m5: del.filter(function (e) { return e.mag >= 5; }).length });
            f = sumarDia(f);
        }
        return dias;
    }

    // Magnitud de cada réplica según las horas desde el terremoto, con el promedio de cada 6 horas.
    function scatterSvg(D) {
        var w = angosto() ? 380 : 600, h = 220, left = 26, right = 12, top = 14, bottom = 26;
        var plotW = w - left - right, plotH = h - top - bottom;
        var horas = Math.max(12, (D.tu - D.t0) / 36e5), xMax = Math.ceil(horas / 12) * 12;
        function x(hh) { return left + (hh / xMax) * plotW; }
        function y(m) { return top + (1 - (Math.max(2, Math.min(8, m)) - 2) / 6) * plotH; }

        var grid = '';
        for (var m = 2; m <= 8; m += 2) {
            grid += '<line x1="' + left + '" y1="' + y(m) + '" x2="' + (w - right) + '" y2="' + y(m) + '" stroke="rgba(255,255,255,0.08)" stroke-width="1"/>';
            grid += '<text x="' + (left - 8) + '" y="' + (y(m) + 4) + '" font-size="11" fill="rgba(255,255,255,0.4)" text-anchor="end">' + m + '</text>';
        }
        // Medianoches: línea punteada con el día
        var noches = '', f = sumarDia(D.P.fecha_hora.slice(0, 10));
        while (true) {
            var hh = (ts(f + 'T00:00:00') - D.t0) / 36e5;
            if (hh > xMax) break;
            noches += '<line x1="' + x(hh) + '" y1="' + top + '" x2="' + x(hh) + '" y2="' + (top + plotH) + '" stroke="rgba(232,201,136,0.35)" stroke-dasharray="3 4" stroke-width="1"/>' +
                '<text x="' + (x(hh) + 4) + '" y="' + (top + 10) + '" font-size="10" fill="rgba(232,201,136,0.75)">' + DCORTO[diaN(f)] + '</text>';
            f = sumarDia(f);
        }
        var xl = '';
        for (var k = 0; k <= xMax; k += (xMax > 96 || angosto() ? 48 : 24)) {
            xl += '<text x="' + x(k) + '" y="' + (h - 6) + '" font-size="11" fill="rgba(255,255,255,0.4)" text-anchor="middle">' + k + ' h</text>';
        }
        var pts = '';
        D.rep.slice().sort(function (a, b) { return a.mag - b.mag; }).forEach(function (e) {
            var c = e.mag >= 5 ? 'var(--sw-salmon)' : (e.mag >= 4 ? 'var(--sw-amber)' : 'var(--sw-green)');
            var r = e.mag >= 5 ? 4.5 : (e.mag >= 4 ? 3 : 2.3);
            pts += '<circle cx="' + x((e.t - D.t0) / 36e5).toFixed(1) + '" cy="' + y(e.mag).toFixed(1) + '" r="' + r + '" fill="' + c + '" fill-opacity="0.75"/>';
        });
        var linea = '', b;
        for (b = 0; b * 6 < horas; b++) {
            var en = D.rep.filter(function (e) { var q = (e.t - D.t0) / 36e5; return q >= b * 6 && q < b * 6 + 6; });
            if (en.length < 3) continue;
            var prom = en.reduce(function (a, e) { return a + e.mag; }, 0) / en.length;
            linea += (linea ? 'L' : 'M') + x(b * 6 + 3).toFixed(1) + ',' + y(prom).toFixed(1) + ' ';
        }
        return '<svg viewBox="0 0 ' + w + ' ' + h + '" preserveAspectRatio="none" role="img" aria-label="Magnitud de cada réplica según las horas desde el terremoto">' +
            grid + noches + xl + pts +
            '<path d="' + linea + '" fill="none" stroke="var(--sw-blue)" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round"/>' +
            '</svg>';
    }

    // Réplicas de 5 o más por día, con el total del día debajo.
    function barSvg(dias, D) {
        var w = angosto() ? 380 : 600, h = angosto() ? 200 : 190, left = 8, right = 8, top = 22, bottom = 40;
        var plotW = w - left - right, plotH = h - top - bottom;
        var n = dias.length, gap = n > 6 ? 10 : 18;
        var barW = Math.min(90, plotW / n - gap);
        var off = left + (plotW - n * (barW + gap) + gap) / 2;
        var maxV = Math.max.apply(null, dias.map(function (d) { return d.m5; }).concat([1]));
        var base = top + plotH, hoy = D.ult.slice(0, 10), out = '';
        dias.forEach(function (d, i) {
            var bx = off + i * (barW + gap), cx = bx + barW / 2;
            var bh = Math.max(3, (d.m5 / maxV) * plotH);
            out += '<rect x="' + bx + '" y="' + (base - bh) + '" width="' + barW + '" height="' + bh + '" fill="' + (d.m5 ? 'var(--sw-salmon)' : 'rgba(255,255,255,0.18)') + '" rx="3"/>';
            out += '<text x="' + cx + '" y="' + (base - bh - 6) + '" font-size="13" font-weight="800" fill="' + (d.m5 ? '#fff' : 'rgba(255,255,255,0.5)') + '" text-anchor="middle">' + d.m5 + '</text>';
            out += '<text x="' + cx + '" y="' + (base + 15) + '" font-size="11" font-weight="700" fill="rgba(255,255,255,0.75)" text-anchor="middle">' + DCORTO[diaN(d.f)] + ' ' + (+d.f.slice(8, 10)) + (d.f === hoy ? '*' : '') + '</text>';
            out += '<text x="' + cx + '" y="' + (base + 30) + '" font-size="10" fill="rgba(255,255,255,0.4)" text-anchor="middle">' + d.total + ' en total</text>';
        });
        return '<svg viewBox="0 0 ' + w + ' ' + h + '" preserveAspectRatio="none" role="img" aria-label="Réplicas de magnitud 5 o más por día">' +
            '<line x1="' + left + '" y1="' + base + '" x2="' + (w - right) + '" y2="' + base + '" stroke="rgba(255,255,255,0.25)" stroke-width="1"/>' + out + '</svg>';
    }

    function render(d) {
        var D = prep(d), R = D.rep, hoy = hoyPa(), ahora = Date.now();
        var m5 = R.filter(function (e) { return e.mag >= 5; });
        var m4 = R.filter(function (e) { return e.mag >= 4 && e.mag < 5; }).length;
        var m3 = R.length - m5.length - m4;
        var deHoy = R.filter(function (e) { return e.f === hoy; });
        var u24 = R.filter(function (e) { return e.t >= ahora - 24 * 36e5; });
        var u = R[R.length - 1];
        var dias = porDia(D), completos = dias.filter(function (x) { return x.f !== D.ult.slice(0, 10); });
        var pct = function (v) { return R.length ? Math.round(v / R.length * 100) : 0; };
        var p5 = pct(m5.length), p4 = pct(m4), p3 = 100 - p5 - p4;
        var corte = DIAS[diaN(D.ult.slice(0, 10))] + ' ' + (+D.ult.slice(8, 10)) + ' de ' + MESES[+D.ult.slice(5, 7) - 1] + ', ' + hora(D.ult);
        var subBarras = completos.length >= 2
            ? 'De ' + completos[0].m5 + ' el ' + DIAS[diaN(completos[0].f)] + ' a ' + completos[completos.length - 1].m5 + ' el ' + DIAS[diaN(completos[completos.length - 1].f)] + '. * Hoy, hasta las ' + hora(D.ult)
            : 'Cada día desde el terremoto.';

        root.innerHTML =
            '<div class="sismo-header">' +
                '<span class="sismo-live"><span class="sismo-live-dot"></span> En vivo</span>' +
                '<span class="sismo-updated">Listado del IGC al ' + corte + '</span>' +
            '</div>' +
            '<div class="sismo-grid">' +
                '<div>' +
                    '<div class="sismo-total-card">' +
                        '<div class="sismo-total-value">' + R.length.toLocaleString('es-PA') + '</div>' +
                        '<div class="sismo-total-label">réplicas desde el terremoto de 7.7 del viernes 9 de octubre</div>' +
                        '<div class="sismo-progress">' +
                            '<span style="flex:' + p3 + ';background:var(--sw-green)">' + (p3 >= 8 ? p3 + '%' : '') + '</span>' +
                            '<span style="flex:' + p4 + ';background:var(--sw-amber)">' + (p4 >= 8 ? p4 + '%' : '') + '</span>' +
                            '<span style="flex:' + p5 + ';background:var(--sw-salmon)">' + (p5 >= 8 ? p5 + '%' : '') + '</span>' +
                        '</div>' +
                        '<div class="sismo-legend">' +
                            '<span><span class="sismo-legend-dot" style="background:var(--sw-green)"></span>' + m3 + ' menores de 4</span>' +
                            '<span><span class="sismo-legend-dot" style="background:var(--sw-amber)"></span>' + m4 + ' de 4 a 4.9</span>' +
                            '<span><span class="sismo-legend-dot" style="background:var(--sw-salmon)"></span>' + m5.length + ' de 5 o más</span>' +
                        '</div>' +
                    '</div>' +
                    '<div class="sismo-stats">' +
                        '<div class="sismo-stat-card">' +
                            '<div class="sismo-stat-label">Hoy</div>' +
                            '<div class="sismo-stat-value">' + deHoy.length + '</div>' +
                            '<div class="sismo-stat-sub">' + (deHoy.length ? 'réplicas; la mayor, de ' + m1(maxMag(deHoy)) : 'réplicas en lo que va del día') + '</div>' +
                        '</div>' +
                        '<div class="sismo-stat-card">' +
                            '<div class="sismo-stat-label">Últimas 24 horas</div>' +
                            '<div class="sismo-stat-value">' + u24.length + '</div>' +
                            '<div class="sismo-stat-sub">réplicas' + (u24.length ? '; la mayor, de ' + m1(maxMag(u24)) : '') + '</div>' +
                        '</div>' +
                        '<div class="sismo-stat-card">' +
                            '<div class="sismo-stat-label">La más fuerte</div>' +
                            '<div class="sismo-stat-value">' + m1(maxMag(R)) + '</div>' +
                            '<div class="sismo-stat-sub">réplica de mayor magnitud desde el viernes</div>' +
                        '</div>' +
                        '<div class="sismo-stat-card">' +
                            '<div class="sismo-stat-label">La más reciente</div>' +
                            '<div class="sismo-stat-value">' + (u ? m1(u.mag) : '–') + '</div>' +
                            '<div class="sismo-stat-sub">' + (u ? hora(u.iso) + ', ' + donde(u) + (u.rev ? '' : ' (preliminar)') : '') + '</div>' +
                        '</div>' +
                    '</div>' +
                '</div>' +
                '<div class="sismo-charts">' +
                    '<div class="sismo-chart-card">' +
                        '<div class="sismo-chart-title">Magnitud de cada réplica</div>' +
                        '<div class="sismo-chart-sub">' + R.length + ' réplicas en ' + Math.floor((D.tu - D.t0) / 36e5) + ' horas desde el terremoto</div>' +
                        scatterSvg(D) +
                        '<div class="sismo-chart-legend">' +
                            '<span><span class="sismo-legend-dot" style="background:var(--sw-green)"></span>menor de 4</span>' +
                            '<span><span class="sismo-legend-dot" style="background:var(--sw-amber)"></span>4 a 4.9</span>' +
                            '<span><span class="sismo-legend-dot" style="background:var(--sw-salmon)"></span>5 o más</span>' +
                            '<span><span class="sismo-legend-dot" style="background:var(--sw-blue);border-radius:2px;height:3px;width:14px;vertical-align:middle"></span>promedio de cada 6 horas</span>' +
                        '</div>' +
                    '</div>' +
                    '<div class="sismo-chart-card">' +
                        '<div class="sismo-chart-title">Réplicas de magnitud 5 o más, por día</div>' +
                        '<div class="sismo-chart-sub">' + subBarras + '</div>' +
                        barSvg(dias, D) +
                    '</div>' +
                '</div>' +
            '</div>' +
            '<div class="sismo-footer">' +
                '<span>Fuente: Instituto de Geociencias de la Universidad de Panamá (magnitudes preliminares pueden cambiar). Terremoto: USGS.</span>' +
                '<a href="https://pro.nexo.la/terremoto.html">Ver el tablero completo →</a>' +
            '</div>';
    }

    function cargar() {
        fetch(DATA_URL + '?v=' + Date.now())
            .then(function (r) {
                if (!r.ok) throw new Error('HTTP ' + r.status);
                return r.json();
            })
            .then(render)
            .catch(function () {
                if (!root.querySelector('.sismo-grid')) root.innerHTML = '<div class="sismo-error">No se pudo cargar el listado de sismos.</div>';
            });
    }
    cargar();
    setInterval(cargar, 300000);
})();
</script>
