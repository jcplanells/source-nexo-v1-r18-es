<style>
    .bloque-agua-energia {
        padding-top: 20px;
        padding-bottom: 20px;
        margin-top: 20px;
    }
    .bloque-agua-energia .gh-container-title {
        margin-bottom: 30px;
        color: var(--color-base, #000);
        border-bottom: none;
    }
    .grid-bloque-agua-energia {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 32px;
        align-items: start;
    }
    /* Noticia destacada: ocupa columnas 1-2 */
    .col-agua-energia-principal {
        grid-column: span 2;
        align-self: stretch;
        display: flex;
        flex-direction: column;
    }
    /* CTA newsletter: rellena el espacio bajo la destacada, alineado al pie de las columnas 3-4 */
    .cta-agua-energia {
        margin-top: auto;
        border-left: 3px solid #34CC03;
        background: #F1F2E9;
        padding: 22px 26px;
        border-radius: 0 12px 12px 0;
    }
    .col-agua-energia-principal .card-agua-energia-featured {
        margin-bottom: 28px;
    }
    .cta-agua-energia-eyebrow {
        font-family: 'DM Sans', sans-serif;
        font-size: 1.1rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: #34CC03;
        margin: 0 0 6px;
    }
    .cta-agua-energia-title {
        font-family: 'Playfair Display', serif;
        font-size: 1.9rem;
        font-weight: 700;
        color: #020202;
        line-height: 1.25;
        margin: 0 0 14px;
    }
    .cta-agua-energia-form {
        display: flex;
        gap: 8px;
    }
    .cta-agua-energia-input {
        flex: 1;
        font-family: 'DM Sans', sans-serif;
        font-size: 1.4rem;
        padding: 10px 18px;
        border: 1.5px solid #122805;
        border-radius: 100px;
        background: #fff;
        color: #020202;
        outline: none;
        min-width: 0;
    }
    .cta-agua-energia-input:focus {
        border-color: #34CC03;
        box-shadow: 0 0 0 3px rgba(52,204,3,0.2);
    }
    .cta-agua-energia-input::placeholder { color: #888; }
    .cta-agua-energia-btn {
        font-family: 'DM Sans', sans-serif;
        font-size: 1.4rem;
        font-weight: 500;
        padding: 10px 24px;
        background: #34CC03;
        color: #020202;
        border: none;
        border-radius: 100px;
        cursor: pointer;
        transition: background 0.2s;
        white-space: nowrap;
    }
    .cta-agua-energia-btn:hover { background: #9CF469; }
    .card-agua-energia-featured img {
        width: 100%;
        aspect-ratio: 16/9;
        object-fit: cover;
        border-radius: 3px;
        margin-bottom: 14px;
    }
    .card-agua-energia-featured h3 {
        font-size: 2.4rem;
        line-height: 1.2;
        margin: 0;
    }
    .card-agua-energia-featured h3 a {
        color: var(--color-base, #000);
        text-decoration: none;
    }
    .card-agua-energia-featured .featured-excerpt {
        display: -webkit-box;
        -webkit-line-clamp: 4;
        -webkit-box-orient: vertical;
        overflow: hidden;
        font-size: 1.5rem;
        line-height: 1.6;
        color: #555;
        margin: 12px 0 8px;
    }
    .card-agua-energia-featured .featured-meta {
        font-size: 1.3rem;
        color: #888;
    }
    /* Columna 3: 3 notas apiladas */
    .col-agua-energia-notas {
        display: flex;
        flex-direction: column;
        gap: 18px;
    }
    .card-agua-energia-nota img {
        width: 100%;
        aspect-ratio: 16/9;
        object-fit: cover;
        border-radius: 3px;
        margin-bottom: 8px;
    }
    .card-agua-energia-nota h3 {
        font-size: 1.5rem;
        line-height: 1.2;
        margin: 0;
    }
    .card-agua-energia-nota h3 a {
        color: var(--color-base, #000);
        text-decoration: none;
    }
    .card-agua-energia-nota .nota-meta {
        display: block;
        font-size: 1.2rem;
        color: #888;
        margin-top: 6px;
    }
    /* Columna 4: 5ª nota + widget lago Gatún */
    .col-agua-energia-widget {
        align-self: stretch;
        display: flex;
        flex-direction: column;
    }
    .col-agua-energia-widget .card-agua-energia-nota {
        margin-bottom: 20px;
    }
    @media (max-width: 991px) {
        .grid-bloque-agua-energia {
            grid-template-columns: repeat(2, 1fr);
        }
        .col-agua-energia-principal {
            grid-column: span 2;
        }
        /* Debajo de desktop las columnas 3-4 bajan y ya no queda hueco que rellenar */
        .cta-agua-energia {
            display: none;
        }
    }
    @media (max-width: 767px) {
        .grid-bloque-agua-energia {
            grid-template-columns: 1fr;
        }
        .col-agua-energia-principal {
            grid-column: span 1;
        }
        .card-agua-energia-nota {
            display: flex;
            flex-direction: row;
            gap: 12px;
            align-items: flex-start;
        }
        .card-agua-energia-nota > a {
            flex-shrink: 0;
            width: 110px;
        }
        .card-agua-energia-nota img {
            width: 100%;
            aspect-ratio: 16/9;
            margin-bottom: 0;
        }
        .card-agua-energia-nota .nota-text {
            flex: 1;
            min-width: 0;
        }
    }
</style>

<section class="gh-outer bloque-agua-energia">
    <div class="gh-inner">
        <h2 class="gh-container-title">
            <span style="border-bottom: 3px solid var(--ghost-accent-color); padding-bottom: 9px;">
                <a href="https://nexo.la/agua-y-energia/" style="text-decoration: none; color: inherit;">Agua, Energía y Logística</a>
            </span>
        </h2>

        <div class="grid-bloque-agua-energia">
            {{#get "posts" filter="primary_tag:[agua,energia,logistica]" limit="5" include="authors"}}
                {{!-- Noticia destacada: primera entrada, ocupa columnas 1-2; debajo, CTA del newsletter --}}
                <div class="col-agua-energia-principal">
                    {{#foreach posts}}
                        {{#if @first}}
                            <article class="card-agua-energia-featured">
                                {{#if feature_image}}
                                    <a href="{{url}}">
                                        <img src="{{feature_image}}" alt="{{title}}">
                                    </a>
                                {{/if}}
                                <h3><a href="{{url}}">{{title}}</a></h3>
                                <p class="featured-excerpt">{{excerpt}}</p>
                                <span class="featured-meta">{{reading_time minute="1 min de lectura" minutes="% min de lectura"}}</span>
                            </article>
                        {{/if}}
                    {{/foreach}}

                    {{#unless @member}}
                    <div class="cta-agua-energia">
                        <p class="cta-agua-energia-eyebrow">Newsletter gratuito</p>
                        <h3 class="cta-agua-energia-title">Panamá, explicada. Cada mañana en tu correo.</h3>
                        <form autocomplete="false" role="form" method="post"
                              action="https://mautic.adulting.club/form/submit?formId=2"
                              id="mauticform_agua_energia"
                              data-mautic-form="registronexoaguaenergia"
                              enctype="multipart/form-data"
                              class="cta-agua-energia-form">
                            <input type="email"
                                   name="mauticform[correo]"
                                   id="mauticform_input_agua_energia_correo"
                                   class="cta-agua-energia-input"
                                   placeholder="tucorreo@ejemplo.com"
                                   aria-label="Correo electrónico"
                                   required>
                            <button type="submit"
                                    name="mauticform[submit]"
                                    value="1"
                                    class="cta-agua-energia-btn"
                                    data-umami-event="portada-cta-newsletter"
                                    data-umami-event-bloque="agua-energia">Suscribirme</button>
                            <input type="hidden" name="mauticform[formId]" value="2">
                            <input type="hidden" name="mauticform[return]" value="">
                            <input type="hidden" name="mauticform[formName]" value="registronexo">
                        </form>
                    </div>
                    {{/unless}}
                </div>

                {{!-- Columna 3: notas 2, 3 y 4 (ni primera ni última) --}}
                <div class="col-agua-energia-notas">
                    {{#foreach posts}}
                        {{#unless @first}}
                            {{#unless @last}}
                                <article class="card-agua-energia-nota">
                                    {{#if feature_image}}
                                        <a href="{{url}}">
                                            <img src="{{feature_image}}" alt="{{title}}">
                                        </a>
                                    {{/if}}
                                    <div class="nota-text">
                                        <h3><a href="{{url}}">{{title}}</a></h3>
                                        <span class="nota-meta">{{reading_time minute="1 min de lectura" minutes="% min de lectura"}}</span>
                                    </div>
                                </article>
                            {{/unless}}
                        {{/unless}}
                    {{/foreach}}
                </div>

                {{!-- Columna 4: 5ª nota + widget lago Gatún --}}
                <div class="col-agua-energia-widget">
                    {{#foreach posts}}
                        {{#if @last}}
                            <article class="card-agua-energia-nota">
                                {{#if feature_image}}
                                    <a href="{{url}}">
                                        <img src="{{feature_image}}" alt="{{title}}">
                                    </a>
                                {{/if}}
                                <div class="nota-text">
                                    <h3><a href="{{url}}">{{title}}</a></h3>
                                    <span class="nota-meta">{{reading_time minute="1 min de lectura" minutes="% min de lectura"}}</span>
                                </div>
                            </article>
                        {{/if}}
                    {{/foreach}}
                    {{> "components/widget-gatun"}}
                </div>
            {{/get}}
        </div>

        <div style="text-align: right; margin-top: 15px;">
            <a href="https://nexo.la/agua-y-energia/" style="color: var(--ghost-accent-color); font-weight: bold; text-decoration: none;">ver más...</a>
        </div>
    </div>
</section>
