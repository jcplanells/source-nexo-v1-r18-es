<style>
    .bloque-agua-energia {
        padding-top: 20px;
        padding-bottom: 20px;
        margin-top: 20px;
    }
    .bloque-agua-energia .gh-container-title {
        margin-bottom: 30px;
        color: var(--color-base, #000);
        border-bottom: none;
    }
    .grid-bloque-agua-energia {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 32px;
        align-items: start;
    }
    /* Noticia destacada: ocupa columnas 1-2 */
    .card-agua-energia-featured {
        grid-column: span 2;
    }
    .card-agua-energia-featured img {
        width: 100%;
        aspect-ratio: 16/9;
        object-fit: cover;
        border-radius: 3px;
        margin-bottom: 14px;
    }
    .card-agua-energia-featured h3 {
        font-size: 2.4rem;
        line-height: 1.2;
        margin: 0;
    }
    .card-agua-energia-featured h3 a {
        color: var(--color-base, #000);
        text-decoration: none;
    }
    .card-agua-energia-featured .featured-excerpt {
        display: -webkit-box;
        -webkit-line-clamp: 4;
        -webkit-box-orient: vertical;
        overflow: hidden;
        font-size: 1.5rem;
        line-height: 1.6;
        color: #555;
        margin: 12px 0 8px;
    }
    .card-agua-energia-featured .featured-meta {
        font-size: 1.3rem;
        color: #888;
    }
    /* Columna 3: 3 notas apiladas */
    .col-agua-energia-notas {
        display: flex;
        flex-direction: column;
        gap: 18px;
    }
    .card-agua-energia-nota img {
        width: 100%;
        aspect-ratio: 16/9;
        object-fit: cover;
        border-radius: 3px;
        margin-bottom: 8px;
    }
    .card-agua-energia-nota h3 {
        font-size: 1.5rem;
        line-height: 1.2;
        margin: 0;
    }
    .card-agua-energia-nota h3 a {
        color: var(--color-base, #000);
        text-decoration: none;
    }
    .card-agua-energia-nota .nota-meta {
        display: block;
        font-size: 1.2rem;
        color: #888;
        margin-top: 6px;
    }
    /* Columna 4: 5ª nota + widget lago Gatún */
    .col-agua-energia-widget {
        align-self: stretch;
        display: flex;
        flex-direction: column;
    }
    .col-agua-energia-widget .card-agua-energia-nota {
        margin-bottom: 20px;
    }
    @media (max-width: 991px) {
        .grid-bloque-agua-energia {
            grid-template-columns: repeat(2, 1fr);
        }
        .card-agua-energia-featured {
            grid-column: span 2;
        }
    }
    @media (max-width: 767px) {
        .grid-bloque-agua-energia {
            grid-template-columns: 1fr;
        }
        .card-agua-energia-featured {
            grid-column: span 1;
        }
        .card-agua-energia-nota {
            display: flex;
            flex-direction: row;
            gap: 12px;
            align-items: flex-start;
        }
        .card-agua-energia-nota > a {
            flex-shrink: 0;
            width: 110px;
        }
        .card-agua-energia-nota img {
            width: 100%;
            aspect-ratio: 16/9;
            margin-bottom: 0;
        }
        .card-agua-energia-nota .nota-text {
            flex: 1;
            min-width: 0;
        }
    }
</style>

<section class="gh-outer bloque-agua-energia">
    <div class="gh-inner">
        <h2 class="gh-container-title">
            <span style="border-bottom: 3px solid var(--ghost-accent-color); padding-bottom: 9px;">
                <a href="https://nexo.la/agua-y-energia/" style="text-decoration: none; color: inherit;">Agua y Energía</a>
            </span>
        </h2>

        <div class="grid-bloque-agua-energia">
            {{#get "posts" filter="primary_tag:[agua,energia]" limit="5" include="authors"}}
                {{!-- Noticia destacada: primera entrada, ocupa columnas 1-2 --}}
                {{#foreach posts}}
                    {{#if @first}}
                        <article class="card-agua-energia-featured">
                            {{#if feature_image}}
                                <a href="{{url}}">
                                    <img src="{{feature_image}}" alt="{{title}}">
                                </a>
                            {{/if}}
                            <h3><a href="{{url}}">{{title}}</a></h3>
                            <p class="featured-excerpt">{{excerpt}}</p>
                            <span class="featured-meta">{{reading_time minute="1 min de lectura" minutes="% min de lectura"}}</span>
                        </article>
                    {{/if}}
                {{/foreach}}

                {{!-- Columna 3: notas 2, 3 y 4 (ni primera ni última) --}}
                <div class="col-agua-energia-notas">
                    {{#foreach posts}}
                        {{#unless @first}}
                            {{#unless @last}}
                                <article class="card-agua-energia-nota">
                                    {{#if feature_image}}
                                        <a href="{{url}}">
                                            <img src="{{feature_image}}" alt="{{title}}">
                                        </a>
                                    {{/if}}
                                    <div class="nota-text">
                                        <h3><a href="{{url}}">{{title}}</a></h3>
                                        <span class="nota-meta">{{reading_time minute="1 min de lectura" minutes="% min de lectura"}}</span>
                                    </div>
                                </article>
                            {{/unless}}
                        {{/unless}}
                    {{/foreach}}
                </div>

                {{!-- Columna 4: 5ª nota + widget lago Gatún --}}
                <div class="col-agua-energia-widget">
                    {{#foreach posts}}
                        {{#if @last}}
                            <article class="card-agua-energia-nota">
                                {{#if feature_image}}
                                    <a href="{{url}}">
                                        <img src="{{feature_image}}" alt="{{title}}">
                                    </a>
                                {{/if}}
                                <div class="nota-text">
                                    <h3><a href="{{url}}">{{title}}</a></h3>
                                    <span class="nota-meta">{{reading_time minute="1 min de lectura" minutes="% min de lectura"}}</span>
                                </div>
                            </article>
                        {{/if}}
                    {{/foreach}}
                    {{> "components/widget-gatun"}}
                </div>
            {{/get}}
        </div>

        <div style="text-align: right; margin-top: 15px;">
            <a href="https://nexo.la/agua-y-energia/" style="color: var(--ghost-accent-color); font-weight: bold; text-decoration: none;">ver más...</a>
        </div>
    </div>
</section>
