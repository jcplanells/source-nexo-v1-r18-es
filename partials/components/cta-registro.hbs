<style type="text/css">
    /* Estilos específicos para el formulario de registro */
    .cta-registro-root {
      --form-primary-60: #ffffff;
      --form-primary-70: color-mix(in hsl, var(--form-primary-60), black 10%);
      --form-primary-80: color-mix(in hsl, var(--form-primary-60), black 20%);
      --form-field: #ffffff;
      --form-field-hover: #f7f7f7;
      --form-font-family: Arial, Helvetica, sans-serif;
      --form-border-subtle: #cccccc;
      --form-border-strong: #8d8d8d;
      --form-button-primary: #34cc03;
      --form-button-primary-hover: #2ca302;
      --form-button-primary-active: #1f7a02;
      --form-text-primary: #000000;
      --form-text-brand: #34cc03;
      --form-text-placeholder: #666666;
      --form-text-on-color: #ffffff;
      --form-support-error: #ff3333;
      --form-support-success: #34cc03;
      --form-transition-all-productive: all 150ms cubic-bezier(0.2, 0, 0.38, 0.9);
      --form-transition-all-expressive: all 300ms cubic-bezier(0.4, 0.14, 0.3, 1);
    }

    .mauticform_wrapper {
      max-width: 600px;
      margin: 40px auto; /* Ajustado margen vertical */
      padding: 40px;
      background-color: #ffffff;
      border-radius: 12px;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
      font-family: var(--form-font-family);
      font-size: 14px;
      width: 100%;
      text-align: center;
      border: 1px solid var(--form-border-subtle);
      box-sizing: border-box;
    }

    .mauticform-input,
    .mauticform-textarea {
      width: 100%;
      padding: 15px;
      border: 1px solid var(--form-border-subtle);
      border-radius: 8px;
      background-color: var(--form-field);
      color: var(--form-text-primary);
      font-size: 16px;
      box-sizing: border-box;
      outline: 2px solid transparent;
      outline-offset: -2px;
      transition: var(--form-transition-all-productive);
      text-align: left;
    }

    .mauticform-input:focus,
    .mauticform-textarea:focus {
      border-color: #34cc03;
      box-shadow: 0 0 5px rgba(52, 204, 3, 0.4);
      outline: 2px solid #34cc03;
      background-color: var(--form-field-hover);
    }

    .mauticform-label {
      font-size: 14px;
      display: block;
      font-weight: bold;
      margin-bottom: 5px;
      color: #000000;
      text-align: left;
    }

    .mauticform-button-wrapper {
      text-align: center;
      margin-top: 20px;
    }

    .mauticform-button {
      display: inline-block;
      margin-bottom: 0;
      font-weight: 600;
      text-align: center;
      vertical-align: middle;
      cursor: pointer;
      background-image: none;
      border: 1px solid transparent;
      white-space: nowrap;
      padding: 10px 20px;
      font-size: 13px;
      line-height: 1.3856;
      border-radius: 8px;
      user-select: none;
      background-color: var(--form-button-primary);
      color: #ffffff;
      transition: var(--form-transition-all-expressive);
    }

    .mauticform-button:hover {
      transform: translateY(-2px);
      box-shadow: 0 4px 10px rgba(52, 204, 3, 0.25);
      background-color: var(--form-button-primary-hover);
    }

    .form-title { margin-bottom: 5px; text-align: center; }
    .form-subtitle { font-size: 1.2em; color: #000000; margin-bottom: 20px; text-align: center; }
    .mauticform-row { display: block; margin-bottom: 20px; }
    .mauticform-field-hidden { display: none; }
    .mauticform-errormsg { display: block; color: var(--form-support-error); margin-top: 2px; }
    .mauticform-row.mauticform-required .mauticform-label:after { color: var(--form-support-error); content: "*"; display: inline; }

    @media screen and (max-width: 768px) {
      .mauticform_wrapper { padding: 20px; }
    }
</style>

