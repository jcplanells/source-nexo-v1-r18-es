{{#unless @member}}
<style>
.cta-b {
    background: #F1F2E9;
    padding: 48px 40px;
    text-align: center;
    max-width: 640px;
    margin: 0 auto;
    border-radius: 16px;
}
.cta-b-logo {
    display: block;
    height: 44px;
    width: auto;
    margin: 0 auto 20px;
}
.cta-b-title {
    font-family: 'Playfair Display', serif;
    font-size: 2.6rem;
    font-weight: 700;
    color: #020202;
    line-height: 1.25;
    margin: 0 0 12px;
}
.cta-b-sub {
    font-family: 'DM Sans', sans-serif;
    font-size: 1.5rem;
    font-weight: 400;
    color: #020202;
    line-height: 1.5;
    margin: 0 0 24px;
}
.cta-b-pills {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin-bottom: 28px;
}
.cta-b-pill {
    font-family: 'DM Sans', sans-serif;
    font-size: 1.2rem;
    font-weight: 500;
    color: #122805;
    border: 1.5px solid #122805;
    border-radius: 100px;
    padding: 4px 14px;
}
.cta-b-form {
    display: flex;
    gap: 8px;
    max-width: 440px;
    margin: 0 auto 14px;
}
.cta-b-input {
    flex: 1;
    font-family: 'DM Sans', sans-serif;
    font-size: 1.5rem;
    padding: 12px 20px;
    border: 1.5px solid #122805;
    border-radius: 100px;
    background: #fff;
    color: #020202;
    outline: none;
    min-width: 0;
}
.cta-b-input:focus {
    border-color: #34CC03;
    box-shadow: 0 0 0 3px rgba(52,204,3,0.2);
}
.cta-b-input::placeholder { color: #888; }
.cta-b-btn {
    font-family: 'DM Sans', sans-serif;
    font-size: 1.5rem;
    font-weight: 500;
    padding: 12px 28px;
    background: #34CC03;
    color: #020202;
    border: none;
    border-radius: 100px;
    cursor: pointer;
    transition: background 0.2s;
    white-space: nowrap;
}
.cta-b-btn:hover { background: #9CF469; }
.cta-b-legal {
    font-family: 'DM Sans', sans-serif;
    font-size: 1.1rem;
    color: rgba(2,2,2,0.45);
    margin: 0;
}
.cta-b-msg { font-family: 'DM Sans', sans-serif; font-size: 1.3rem; margin-top: 8px; }
@media (max-width: 600px) {
    .cta-b { padding: 32px 20px; }
    .cta-b-title { font-size: 2.2rem; }
    .cta-b-form { flex-direction: column; }
    .cta-b-btn { width: 100%; text-align: center; }
}
</style>

<div class="cta-b">
    <img class="cta-b-logo" src="https://opt.nexo.la/assets/logos/logo_nexo_verde_trans.png" alt="nexo">
    <h2 class="cta-b-title">Panamá, explicada. Cada mañana en tu correo.</h2>
    <p class="cta-b-sub">El resumen diario de lo que realmente importa: economía, empresas, política y más.</p>
    <div class="cta-b-pills">
        <span class="cta-b-pill">Gratis</span>
        <span class="cta-b-pill">Un correo al día</span>
        <span class="cta-b-pill">Sin spam</span>
        <span class="cta-b-pill">Cancela cuando quieras</span>
    </div>

    <script type="text/javascript">
        if (typeof MauticSDKLoaded == 'undefined') {
            var MauticSDKLoaded = true;
            var head = document.getElementsByTagName('head')[0];
            var script = document.createElement('script');
            script.type = 'text/javascript';
            script.src = 'https://mautic.adulting.club/media/js/mautic-form.js?v819f826d';
            script.onload = function() { MauticSDK.onLoad(); };
            head.appendChild(script);
            var MauticDomain = 'https://mautic.adulting.club';
            var MauticLang = { 'submittingMessage': "Please wait..." };
        } else if (typeof MauticSDK != 'undefined') {
            MauticSDK.onLoad();
        }
    </script>

    <div id="mauticform_wrapper_registronexo" class="mauticform_wrapper" style="all:unset;display:block">
        <div class="mauticform-error" id="mauticform_registronexo_error"></div>
        <div class="mauticform-message cta-b-msg" id="mauticform_registronexo_message"></div>
        <form autocomplete="false" role="form" method="post"
              action="https://mautic.adulting.club/form/submit?formId=2"
              id="mauticform_registronexo"
              data-mautic-form="registronexo"
              enctype="multipart/form-data">
            <div class="mauticform-innerform">
                <div class="mauticform-page-wrapper mauticform-page-1" data-mautic-form-page="1">
                    <div class="cta-b-form">
                        <input type="email"
                               name="mauticform[correo]"
                               id="mauticform_input_registronexo_correo"
                               class="cta-b-input"
                               placeholder="tucorreo@ejemplo.com"
                               required>
                        <button type="submit"
                                name="mauticform[submit]"
                                value="1"
                                id="mauticform_input_registronexo_submit"
                                class="cta-b-btn">Entrar</button>
                    </div>
                </div>
            </div>
            <input type="hidden" name="mauticform[fuente]" value="sitio_web">
            <input type="hidden" name="mauticform[formId]" id="mauticform_registronexo_id" value="2">
            <input type="hidden" name="mauticform[return]" id="mauticform_registronexo_return" value="">
            <input type="hidden" name="mauticform[formName]" id="mauticform_registronexo_name" value="registronexo">
        </form>
    </div>
    <p class="cta-b-legal">Al suscribirte aceptas recibir el newsletter de nexo.la</p>
</div>
{{/unless}}
