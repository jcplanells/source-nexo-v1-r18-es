<form class="gh-form" data-members-form>
    <input class="gh-form-input" id="{{email_field_id}}" name="email" type="email" placeholder="tu@email.com" required data-members-email>
    <button class="gh-button" type="submit" aria-label="Regístrate">
        <span>Regístrate {{> "icons/arrow"}}</span>
        {{> "icons/loader"}}
        {{> "icons/checkmark"}}
    </button>
    <p data-members-error></p>
</form>
