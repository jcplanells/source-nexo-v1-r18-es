{
  "$schema": "https://cdn.ghost.io/schemas/config.schema.json",
  "version": "1.0",
  "title": "Nexo",
  "description": "Theme configuration for Nexo - Custom theme based on Source",
  "settings": {
    "header_style": {
      "type": "select",
      "options": [
        {
          "value": "highlight",
          "label": "Highlight"
        },
        {
          "value": "minimal",
          "label": "Minimal"
        },
        {
          "value": "standard",
          "label": "Standard"
        }
      ],
      "default": "highlight"
    },
    "accent_color": {
      "type": "color",
      "default": "#1a1a1a"
    },
    "secondary_color": {
      "type": "color",
      "default": "#f5f5f5"
    }
  }
}
